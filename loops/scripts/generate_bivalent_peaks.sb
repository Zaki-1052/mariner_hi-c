#!/bin/bash
# scripts/generate_bivalent_peaks.sb
# Generate bivalent promoter peak files from H3K4me3 + H3K27me3 intersections
#
# Creates three bivalent files:
#   1. Bivalent_Cerebellum_Early.bed - H3K4me3Early + H3K27me3Early
#   2. Bivalent_Cerebellum_Late.bed  - H3K4me3Late + H3K27me3Late
#   3. Bivalent_Consensus_Late.bed   - Consensus H3K4me3 (4 replicates) + H3K27me3Late
#
# Uses bedtools intersect -u to report unique H3K4me3 peaks overlapping H3K27me3
# (avoids double-counting when one H3K4me3 peak overlaps multiple H3K27me3 peaks)
#
# Can run locally with: bash scripts/generate_bivalent_peaks.sb
# Or on HPC with: sbatch scripts/generate_bivalent_peaks.sb

#SBATCH --job-name=bivalent_peaks
#SBATCH --output=logs/bivalent_peaks_%j.out
#SBATCH --partition=shared
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=4G
#SBATCH --time=00:30:00
#SBATCH --account=csd940

echo "========================================="
echo "Bivalent Promoter Peak Generation"
echo "========================================="
echo "Start time: $(date)"
echo "========================================="
echo ""

# =============================================================================
# CONFIGURATION
# =============================================================================

BASE_DIR="$(cd "$(dirname "$0")/.." && pwd)"
PEAKS_DIR="${BASE_DIR}/peaks/beds"
CONSENSUS_DIR="${BASE_DIR}/peaks/peaks-v1"

# Input files - Cerebellum Early
H3K4ME3_EARLY="${PEAKS_DIR}/H3K4me3CerebellumEarly2.bed"
H3K27ME3_EARLY="${PEAKS_DIR}/H3K27me3CerebellumEarly1.bed"

# Input files - Cerebellum Late
H3K4ME3_LATE="${PEAKS_DIR}/H3K4me3CerebellumLate2.bed"
H3K27ME3_LATE="${PEAKS_DIR}/H3K27me3CerebellumLate1.bed"

# Input files - Consensus Late (4-replicate H3K4me3)
H3K4ME3_CONSENSUS="${CONSENSUS_DIR}/consensus_H3K4me3_late_peaks.bed"

# Output files
OUT_EARLY="${PEAKS_DIR}/Bivalent_Cerebellum_Early.bed"
OUT_LATE="${PEAKS_DIR}/Bivalent_Cerebellum_Late.bed"
OUT_CONSENSUS="${PEAKS_DIR}/Bivalent_Consensus_Late.bed"

echo "Configuration:"
echo "  Base directory: ${BASE_DIR}"
echo "  Output directory: ${PEAKS_DIR}"
echo ""

# =============================================================================
# ENVIRONMENT CHECK
# =============================================================================

echo "Environment check:"
if command -v bedtools &> /dev/null; then
    echo "  bedtools: $(which bedtools)"
    bedtools --version
else
    echo "  ERROR: bedtools not found in PATH"
    echo "  Please install bedtools or activate conda environment"
    exit 1
fi
echo ""

# =============================================================================
# INPUT FILE VERIFICATION
# =============================================================================

echo "Checking input files..."
echo ""

echo "  Early timepoint:"
for file in "${H3K4ME3_EARLY}" "${H3K27ME3_EARLY}"; do
    if [ ! -f "${file}" ]; then
        echo "    ERROR: File not found: ${file}"
        exit 1
    fi
    count=$(wc -l < "${file}")
    echo "    $(basename "${file}"): ${count} peaks"
done

echo ""
echo "  Late timepoint:"
for file in "${H3K4ME3_LATE}" "${H3K27ME3_LATE}"; do
    if [ ! -f "${file}" ]; then
        echo "    ERROR: File not found: ${file}"
        exit 1
    fi
    count=$(wc -l < "${file}")
    echo "    $(basename "${file}"): ${count} peaks"
done

echo ""
echo "  Consensus H3K4me3 (4-replicate):"
if [ ! -f "${H3K4ME3_CONSENSUS}" ]; then
    echo "    ERROR: File not found: ${H3K4ME3_CONSENSUS}"
    exit 1
fi
count=$(wc -l < "${H3K4ME3_CONSENSUS}")
echo "    $(basename "${H3K4ME3_CONSENSUS}"): ${count} peaks"
echo ""

# =============================================================================
# GENERATE BIVALENT PEAKS
# =============================================================================

echo "========================================="
echo "Generating bivalent peaks..."
echo "========================================="
echo ""

# --- 1. Bivalent Cerebellum Early ---
echo "1. Bivalent_Cerebellum_Early.bed"
echo "   H3K4me3: $(basename "${H3K4ME3_EARLY}")"
echo "   H3K27me3: $(basename "${H3K27ME3_EARLY}")"
echo "   Command: bedtools intersect -a H3K4me3 -b H3K27me3 -u"

bedtools intersect \
    -a "${H3K4ME3_EARLY}" \
    -b "${H3K27ME3_EARLY}" \
    -u \
    > "${OUT_EARLY}"

count_early=$(wc -l < "${OUT_EARLY}")
echo "   Output: ${count_early} bivalent peaks"
echo ""

# --- 2. Bivalent Cerebellum Late ---
echo "2. Bivalent_Cerebellum_Late.bed"
echo "   H3K4me3: $(basename "${H3K4ME3_LATE}")"
echo "   H3K27me3: $(basename "${H3K27ME3_LATE}")"
echo "   Command: bedtools intersect -a H3K4me3 -b H3K27me3 -u"

bedtools intersect \
    -a "${H3K4ME3_LATE}" \
    -b "${H3K27ME3_LATE}" \
    -u \
    > "${OUT_LATE}"

count_late=$(wc -l < "${OUT_LATE}")
echo "   Output: ${count_late} bivalent peaks"
echo ""

# --- 3. Bivalent Consensus Late ---
echo "3. Bivalent_Consensus_Late.bed"
echo "   H3K4me3: $(basename "${H3K4ME3_CONSENSUS}") (4-replicate consensus)"
echo "   H3K27me3: $(basename "${H3K27ME3_LATE}")"
echo "   Command: bedtools intersect -a H3K4me3_consensus -b H3K27me3 -u"

bedtools intersect \
    -a "${H3K4ME3_CONSENSUS}" \
    -b "${H3K27ME3_LATE}" \
    -u \
    > "${OUT_CONSENSUS}"

count_consensus=$(wc -l < "${OUT_CONSENSUS}")
echo "   Output: ${count_consensus} bivalent peaks"
echo ""

# =============================================================================
# SUMMARY
# =============================================================================

echo "========================================="
echo "Summary"
echo "========================================="
echo ""
echo "Bivalent peak files generated:"
echo ""
echo "  File                           Peaks   Source"
echo "  -----------------------------  ------  ----------------------------------------"
printf "  %-29s  %6d  %s\n" "Bivalent_Cerebellum_Early.bed" "${count_early}" "H3K4me3CerebellumEarly2 + H3K27me3CerebellumEarly1"
printf "  %-29s  %6d  %s\n" "Bivalent_Cerebellum_Late.bed" "${count_late}" "H3K4me3CerebellumLate2 + H3K27me3CerebellumLate1"
printf "  %-29s  %6d  %s\n" "Bivalent_Consensus_Late.bed" "${count_consensus}" "consensus_H3K4me3_late (4-rep) + H3K27me3Late"
echo ""
echo "Comparison:"
echo "  Cerebellum Late vs Consensus Late: ${count_late} vs ${count_consensus} peaks"
echo "  Difference: $((count_consensus - count_late)) additional peaks in consensus"
echo "  Ratio: $(echo "scale=2; ${count_consensus} / ${count_late}" | bc)x more peaks with consensus H3K4me3"
echo ""
echo "Note: Using -u flag ensures each H3K4me3 peak is counted once,"
echo "      even if it overlaps multiple H3K27me3 peaks."
echo ""
echo "Output directory: ${PEAKS_DIR}"
echo ""
echo "========================================="
echo "End time: $(date)"
echo "========================================="
