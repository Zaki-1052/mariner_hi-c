#!/bin/bash
#SBATCH --job-name=apa_shared
#SBATCH --output=logs/apa_shared_%j.out
#SBATCH --partition=shared
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=06:00:00
#SBATCH --account=csd940

# ==============================================================================
# APA Analysis for Shared Anchor Loop Subsets
# ==============================================================================
#
# Performs Aggregate Peak Analysis (APA) on loop subsets from shared anchor
# analysis to validate differential contact enrichment:
#
#   1. Lost long-range loops at shared anchors (141 loops, >1.2 Mb)
#      - Expected: CONTROL > Mutant (loops lost in BAP1-KO)
#
#   2. Gained short-range loops at shared anchors (157 loops, <370 kb)
#      - Expected: MUTANT > Control (loops gained in BAP1-KO)
#
# Prerequisites:
#   - Shared anchor analysis completed (output/shared_anchor_analysis/late/)
#   - .hic files accessible on Expanse
#   - mariner_env conda environment
#
# Expected runtime: ~2-4 hours
# ==============================================================================

# Create logs directory
mkdir -p logs

echo "========================================="
echo "APA Analysis: Shared Anchor Loop Subsets"
echo "========================================="
echo "Job ID: $SLURM_JOB_ID"
echo "Node: $HOSTNAME"
echo "CPUs: $SLURM_CPUS_PER_TASK"
echo "Memory: 64GB"
echo "Start time: $(date)"
echo "========================================="
echo ""

# Activate conda environment
source ~/.bashrc
conda activate mariner_env

echo "Environment check:"
which R
R --version | head -n 1
echo ""

# Change to working directory
cd /expanse/lustre/projects/csd940/zalibhai/mariner_hi-c

# ==============================================================================
# VERIFY INPUT FILES
# ==============================================================================

echo "Checking input files..."

LOST_FILE="output/shared_anchor_analysis/late/apa_subsets/shared_lost_longrange.rds"
GAINED_FILE="output/shared_anchor_analysis/late/apa_subsets/shared_gained_shortrange.rds"

if [ ! -f "$LOST_FILE" ]; then
    echo "ERROR: Missing lost loops file: $LOST_FILE"
    exit 1
fi

if [ ! -f "$GAINED_FILE" ]; then
    echo "ERROR: Missing gained loops file: $GAINED_FILE"
    exit 1
fi

echo "  Found: $LOST_FILE"
echo "  Found: $GAINED_FILE"
echo ""

# ==============================================================================
# VERIFY HIC FILES
# ==============================================================================

echo "Checking .hic files..."

HIC_BASE="/expanse/lustre/projects/csd940/ctea/nf-hic/250831_Bap1_deepseq-2/juicerpre/individual"
SAMPLES="ctrl_M1 ctrl_M2 ctrl_M3 mut_M1 mut_M2 mut_M3"

for SAMPLE in $SAMPLES; do
    HIC_FILE="${HIC_BASE}/${SAMPLE}.hic"
    if [ ! -f "$HIC_FILE" ]; then
        echo "ERROR: Missing .hic file: $HIC_FILE"
        exit 1
    fi
    echo "  Found: $HIC_FILE"
done
echo ""

# ==============================================================================
# RUN APA ANALYSIS
# ==============================================================================

echo "========================================="
echo "Running APA Analysis"
echo "========================================="
echo "Script: scripts/apa_shared_anchors.R"
echo "Input:"
echo "  - Lost long-range: $LOST_FILE"
echo "  - Gained short-range: $GAINED_FILE"
echo "Output: outputs/apa_shared_anchors/late/"
echo ""

Rscript scripts/apa_shared_anchors.R --timepoint late

EXIT_CODE=$?

if [ $EXIT_CODE -eq 0 ]; then
    echo ""
    echo "APA analysis completed successfully"
    echo "   Output: outputs/apa_shared_anchors/late/"
else
    echo ""
    echo "APA analysis failed with exit code $EXIT_CODE"
    exit $EXIT_CODE
fi

echo ""

# ==============================================================================
# VERIFY OUTPUTS
# ==============================================================================

echo "========================================="
echo "Verifying Output Files"
echo "========================================="

OUTPUT_DIR="outputs/apa_shared_anchors/late"

# Check lost_longrange outputs
echo "Lost long-range outputs:"
for FILE in "aggregate_heatmap_ctrl" "aggregate_heatmap_mut" "difference_heatmap" "enrichment_boxplot"; do
    PDF_FILE="${OUTPUT_DIR}/lost_longrange/${FILE}/${FILE}.pdf"
    if [ -f "$PDF_FILE" ]; then
        SIZE=$(ls -lh "$PDF_FILE" | awk '{print $5}')
        echo "    $FILE: $SIZE"
    else
        echo "    WARNING: Missing $PDF_FILE"
    fi
done

echo ""

# Check gained_shortrange outputs
echo "Gained short-range outputs:"
for FILE in "aggregate_heatmap_ctrl" "aggregate_heatmap_mut" "difference_heatmap" "enrichment_boxplot"; do
    PDF_FILE="${OUTPUT_DIR}/gained_shortrange/${FILE}/${FILE}.pdf"
    if [ -f "$PDF_FILE" ]; then
        SIZE=$(ls -lh "$PDF_FILE" | awk '{print $5}')
        echo "    $FILE: $SIZE"
    else
        echo "    WARNING: Missing $PDF_FILE"
    fi
done

echo ""

# Check statistical results
echo "Statistical results:"
for SUBSET in "lost_longrange" "gained_shortrange"; do
    STATS_FILE="${OUTPUT_DIR}/${SUBSET}/statistical_tests.tsv"
    if [ -f "$STATS_FILE" ]; then
        echo "  ${SUBSET}:"
        # Print p-value and effect size
        tail -n 1 "$STATS_FILE" | awk -F'\t' '{printf "    p-value: %.2e, Cliff delta: %.3f\n", $4, $5}'
        tail -n 1 "$STATS_FILE" | awk -F'\t' '{printf "    Mean: ctrl=%.2f, mut=%.2f\n", $8, $9}'
    fi
done

echo ""

# ==============================================================================
# COMPLETE
# ==============================================================================

echo "========================================="
echo "APA ANALYSIS COMPLETE"
echo "========================================="
echo "End time: $(date)"
echo ""
echo "Output directory: $OUTPUT_DIR"
echo ""
echo "Key files:"
echo "  Lost long-range (expected: ctrl > mut):"
echo "    - ${OUTPUT_DIR}/lost_longrange/aggregate_heatmap_ctrl/"
echo "    - ${OUTPUT_DIR}/lost_longrange/aggregate_heatmap_mut/"
echo "    - ${OUTPUT_DIR}/lost_longrange/difference_heatmap/"
echo "    - ${OUTPUT_DIR}/lost_longrange/enrichment_boxplot/"
echo "    - ${OUTPUT_DIR}/lost_longrange/statistical_tests.tsv"
echo ""
echo "  Gained short-range (expected: mut > ctrl):"
echo "    - ${OUTPUT_DIR}/gained_shortrange/aggregate_heatmap_ctrl/"
echo "    - ${OUTPUT_DIR}/gained_shortrange/aggregate_heatmap_mut/"
echo "    - ${OUTPUT_DIR}/gained_shortrange/difference_heatmap/"
echo "    - ${OUTPUT_DIR}/gained_shortrange/enrichment_boxplot/"
echo "    - ${OUTPUT_DIR}/gained_shortrange/statistical_tests.tsv"
echo ""
echo "  Summary: ${OUTPUT_DIR}/summary_report.txt"
echo ""
echo "Interpretation:"
echo "  - Lost loops: APA dot should be visible in Control, weaker in Mutant"
echo "  - Gained loops: APA dot should be visible in Mutant, weaker in Control"
echo "  - Difference heatmaps show the change in contact enrichment"
echo "========================================="
