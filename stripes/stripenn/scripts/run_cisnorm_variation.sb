#!/bin/bash
#SBATCH --job-name=stripe_cisnorm
#SBATCH --output=/expanse/lustre/projects/csd940/zalibhai/stripes/stripenn/logs/cisnorm_%j.out
#SBATCH --partition=shared
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=12:00:00
#SBATCH --account=csd940

# stripes/stripenn/scripts/run_cisnorm_variation.sb
#
# Sensitivity test: cis-contact normalization for stripenn differential analysis.
# Re-runs Stage 4 (edgeR) with valid-cis-contacts as lib.size instead of TMM,
# for both timepoints and both resolutions.
#
# Requires: loops/config/cis_contacts.yaml (generated by loops pipeline)
#
# Usage:
#   sbatch stripes/stripenn/scripts/run_cisnorm_variation.sb

VARIATION="cisnorm"
CODE_DIR="/expanse/lustre/projects/csd940/zalibhai/mariner_hi-c/stripes/stripenn"
DATA_DIR="/expanse/lustre/projects/csd940/zalibhai/stripes/stripenn"
REPO_ROOT="/expanse/lustre/projects/csd940/zalibhai/mariner_hi-c"
CIS_CONTACTS="${REPO_ROOT}/loops/config/cis_contacts.yaml"

echo "========================================="
echo "Stripenn Sensitivity: Cis-Contact Normalization"
echo "========================================="
echo "Job ID: $SLURM_JOB_ID"
echo "Node: $HOSTNAME"
echo "Start: $(date)"
echo "========================================="
echo ""

source ~/.bashrc
conda activate mariner_env

# Verify cis contacts file exists
if [ ! -f "${CIS_CONTACTS}" ]; then
  echo "FATAL: cis_contacts.yaml not found at ${CIS_CONTACTS}"
  echo "Run the loops cisnorm pipeline first to generate it."
  exit 1
fi
echo "Cis contacts file: ${CIS_CONTACTS}"
echo ""

for TIMEPOINT in 250402 250831; do
  for RES in 5000 10000; do
    RES_KB=$((RES / 1000))
    echo "========================================="
    echo "${TIMEPOINT} ${RES_KB}kb — cis-contact normalization"
    echo "========================================="

    Rscript "${CODE_DIR}/scripts/04_edgeR.R" "${TIMEPOINT}" "${RES}" \
      --variation "${VARIATION}" \
      --norm-method none \
      --cis-contacts "${CIS_CONTACTS}"
    STATUS=$?
    if [ $STATUS -ne 0 ]; then
      echo "FATAL: 04_edgeR.R failed for ${TIMEPOINT} ${RES_KB}kb (exit $STATUS)"
      exit 1
    fi
    echo "Done: ${TIMEPOINT} ${RES_KB}kb"
    echo ""
  done
done

echo "========================================="
echo "COMPLETE: Stripenn cis-norm variation"
echo "========================================="
echo "End: $(date)"
echo ""
echo "Outputs (per timepoint/resolution):"
echo "  ${DATA_DIR}/outputs/{tp}/res_{kb}kb/variations/${VARIATION}/04_edgeR/"
