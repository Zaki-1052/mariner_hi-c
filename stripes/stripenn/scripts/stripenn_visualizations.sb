#!/bin/bash
#SBATCH --job-name=stripenn_viz
#SBATCH --output=logs/stripenn_viz_%j.out
#SBATCH --partition=shared
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=04:00:00
#SBATCH --account=csd940

# ==============================================================================
# Stage 7: Stripenn Visualization Analysis
# ==============================================================================
# Generates publication-quality visualizations, annotated BEDPEs, and
# GO/KEGG enrichment from Stripenn differential stripe results.
#
# Prerequisites: Stages 1-6 complete (cross_res_merged.tsv exists)
# Output: outputs/{tp}/visualizations/, outputs/combined/
# ==============================================================================

echo "==========================================="
echo "STRIPENN VISUALIZATION ANALYSIS"
echo "==========================================="
echo "Job ID: ${SLURM_JOB_ID}"
echo "Node: $HOSTNAME"
echo "CPUs: ${SLURM_CPUS_PER_TASK}"
echo "Start time: $(date)"
echo "==========================================="
echo ""

source ~/.bashrc

# Auto-detect HPC vs local
if [ -d "/expanse/lustre/projects/csd940/zalibhai" ]; then
    conda activate mariner_env
    CODE_DIR="/expanse/lustre/projects/csd940/zalibhai/mariner_hi-c/stripes/stripenn"
    DATA_DIR="/expanse/lustre/projects/csd940/zalibhai/stripes/stripenn"
else
    CODE_DIR="$(cd "$(dirname "$0")/.." && pwd)"
    DATA_DIR="${CODE_DIR}"
fi

echo "Environment:"
echo "  CODE_DIR: ${CODE_DIR}"
echo "  DATA_DIR: ${DATA_DIR}"
which R
R --version | head -n 1
echo ""

echo "Checking R packages..."
R --slave -e "library(ggplot2); library(GenomicRanges); library(pheatmap); library(TxDb.Mmusculus.UCSC.mm10.knownGene)" 2>&1
if [ $? -ne 0 ]; then
    echo "ERROR: Required R packages not available"
    exit 1
fi
echo "All required packages available"
echo ""

echo "Checking Stage 6 outputs..."
for TP in 250831 250402; do
    CROSSRES="${DATA_DIR}/outputs/${TP}/cross_res_merged.tsv"
    if [ ! -f "$CROSSRES" ]; then
        echo "WARNING: cross_res_merged.tsv not found for ${TP}"
    else
        N=$(wc -l < "$CROSSRES")
        echo "  ${TP}: $((N - 1)) stripes"
    fi
done
echo ""

cd "${CODE_DIR}"

echo "==========================================="
echo "Running stripenn_visualizations.R"
echo "Start: $(date)"
echo "==========================================="
echo ""

Rscript --vanilla scripts/stripenn_visualizations.R

EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
    echo ""
    echo "ERROR: Visualization script failed (exit code ${EXIT_CODE})"
    exit 1
fi

echo ""
echo "==========================================="
echo "VISUALIZATION COMPLETE"
echo "==========================================="
echo "End time: $(date)"
echo ""

for TP in 250831 250402; do
    echo "${TP} visualizations:"
    find "${DATA_DIR}/outputs/${TP}/visualizations" -name "*.pdf" -o -name "*.tsv" 2>/dev/null | head -20
    echo "  BEDPEs:"
    ls "${DATA_DIR}/outputs/${TP}/"*.bedpe 2>/dev/null
    echo ""
done

echo "Combined:"
find "${DATA_DIR}/outputs/combined" -maxdepth 2 -name "*.pdf" -o -name "*.txt" 2>/dev/null | head -10
echo ""

echo "Enrichment:"
find "${DATA_DIR}/outputs/combined/enrichment" -maxdepth 2 -type f 2>/dev/null | head -10
echo ""

echo "==========================================="
echo "SUCCESS"
echo "==========================================="
