#!/bin/bash
#SBATCH --job-name=stripe_phase3
#SBATCH --output=logs/phase3_%A_%a.out
#SBATCH --partition=shared
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=01:00:00
#SBATCH --account=csd940
#SBATCH --array=0-1

# ==============================================================================
# Phase 3: edgeR Differential Stripe Analysis
# ==============================================================================
#
# Performs differential analysis using quasi-likelihood GLM.
# Lightweight job - only needs counts and metadata.
#
# Array jobs: 0=early, 1=late
#
# Expected runtime: ~5-10 min per timepoint
# Output: {outputs_dir}/{timepoint}/res_5kb/edgeR_results/
# ==============================================================================

# Map array index to timepoint
TIMEPOINTS=("early" "late")
TIMEPOINT=${TIMEPOINTS[$SLURM_ARRAY_TASK_ID]}

echo "========================================="
echo "Stripe Phase 3: edgeR Differential Analysis"
echo "========================================="
echo "Job ID: ${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}"
echo "Timepoint: ${TIMEPOINT}"
echo "Node: $HOSTNAME"
echo "Start time: $(date)"
echo "========================================="
echo ""

# Activate conda environment
source ~/.bashrc
conda activate mariner_env

echo "Environment check:"
which R
R --version | head -n 1
echo ""

# Check for required packages
echo "Checking R packages..."
R --slave -e "library(edgeR); library(ggplot2)" 2>&1
if [ $? -ne 0 ]; then
    echo "ERROR: Required R packages not available"
    exit 1
fi
echo "All required packages available"
echo ""

# Change to project directory
cd /expanse/lustre/projects/csd940/zalibhai/stripes

# Create logs directory if needed
mkdir -p logs

# Verify Phase 2 output exists
PHASE2_OUTPUT="outputs/${TIMEPOINT}/res_5kb/02_stripe_counts.rds"
if [ ! -f "$PHASE2_OUTPUT" ]; then
    echo "ERROR: Phase 2 output not found: ${PHASE2_OUTPUT}"
    echo "Run phase2_quantification.R first"
    exit 1
fi
echo "Phase 2 output found: ${PHASE2_OUTPUT}"
echo ""

echo "Starting Phase 3 edgeR analysis for ${TIMEPOINT}..."
echo ""

Rscript scripts/phase3_edgeR.R ${TIMEPOINT}

if [ $? -eq 0 ]; then
    echo ""
    echo "Phase 3 completed successfully for ${TIMEPOINT}"

    # Verify outputs
    OUTPUT_DIR="outputs/${TIMEPOINT}/res_5kb/edgeR_results"
    if [ -d "$OUTPUT_DIR" ]; then
        echo "Outputs in ${OUTPUT_DIR}:"
        ls -la "${OUTPUT_DIR}"/*.rds "${OUTPUT_DIR}"/*.tsv 2>/dev/null | head -10
    fi
else
    echo ""
    echo "Phase 3 failed for ${TIMEPOINT} with exit code $?"
    exit 1
fi

echo ""
echo "End time: $(date)"
echo "========================================="
