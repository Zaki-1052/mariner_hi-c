#!/bin/bash
#SBATCH --job-name=regen_figs
#SBATCH --output=logs/regen_figs_%j.out
#SBATCH --time=08:00:00
#SBATCH --mem=128G
#SBATCH --cpus-per-task=16
#SBATCH --partition=shared
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --account=csd940
#SBATCH --chdir=/expanse/lustre/projects/csd940/zalibhai/mariner_hi-c

# =============================================================================
# Multi-Format Figure Regeneration Script
# Outputs: PDF (original) + SVG (Illustrator) + JPEG (Google Slides)
# =============================================================================
#
# USAGE:
#   bash scripts/regenerate_all_figures.sb              # Run BOTH timepoints
#   bash scripts/regenerate_all_figures.sb late         # Run LATE only
#   bash scripts/regenerate_all_figures.sb early        # Run EARLY only
#   sbatch scripts/regenerate_all_figures.sb            # SLURM submission
#
# PREREQUISITES:
#   - R packages: svglite (install.packages("svglite"))
#   - All input data files exist in expected locations
#
# OUTPUT DIRECTORIES:
#   The script automatically creates symlinks to save figures alongside
#   existing results:
#     - LATE:  25042-late_outputs/
#     - EARLY: 250831-early_outputs/
#
# =============================================================================

source ~/.bashrc
conda activate mariner_env

# Set base directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BASE_DIR="$(dirname "$SCRIPT_DIR")"
cd "$BASE_DIR"

# Create logs directory
mkdir -p logs

# =============================================================================
# TIMEPOINT CONFIGURATION
# =============================================================================

# Map timepoint names to output directories
declare -A OUTPUT_DIRS
OUTPUT_DIRS["late"]="25042-late_outputs"
OUTPUT_DIRS["early"]="250831-early_outputs"

# Parse command line argument
TIMEPOINT_ARG="${1:-both}"

# Determine which timepoints to run
if [ "$TIMEPOINT_ARG" = "both" ]; then
    TIMEPOINTS=("late" "early")
elif [ "$TIMEPOINT_ARG" = "late" ] || [ "$TIMEPOINT_ARG" = "early" ]; then
    TIMEPOINTS=("$TIMEPOINT_ARG")
else
    echo "ERROR: Invalid argument '$TIMEPOINT_ARG'"
    echo "Usage: $0 [late|early|both]"
    exit 1
fi

echo "=========================================="
echo "Multi-Format Figure Regeneration"
echo "PDF + SVG + JPEG Output"
echo "=========================================="
echo "Working directory: $BASE_DIR"
echo "Timepoints to process: ${TIMEPOINTS[*]}"
echo "Start time: $(date)"
echo ""

# =============================================================================
# FUNCTION: Setup output symlink for a timepoint
# =============================================================================
setup_output_symlink() {
    local timepoint=$1
    local output_dir="${OUTPUT_DIRS[$timepoint]}"

    if [ ! -d "$output_dir" ]; then
        echo "WARNING: Output directory '$output_dir' does not exist for timepoint '$timepoint'"
        return 1
    fi

    # Remove existing symlink or directory named 'outputs' if it's a symlink
    if [ -L "outputs" ]; then
        rm outputs
    elif [ -d "outputs" ] && [ ! -L "outputs" ]; then
        echo "WARNING: 'outputs' exists as a real directory, not a symlink."
        echo "  Skipping symlink creation to avoid data loss."
        echo "  Please manually remove or rename 'outputs/' if you want automatic symlink setup."
        return 1
    fi

    # Create symlink
    ln -sfn "$output_dir" outputs
    echo "  Symlink created: outputs -> $output_dir"
    return 0
}

# =============================================================================
# FUNCTION: Run all visualizations for a single timepoint
# =============================================================================
run_for_timepoint() {
    local TP=$1

    echo ""
    echo "=========================================="
    echo "Processing: $TP timepoint"
    echo "=========================================="

    # Setup symlink: outputs -> {timepoint}_outputs/
    if ! setup_output_symlink "$TP"; then
        echo "ERROR: Failed to setup symlink for $TP. Skipping."
        return 1
    fi

    # --- Section 1: Multi-Format Ready Scripts ---
    echo ""
    echo "=== Section 1: Multi-Format Ready Scripts ($TP) ==="

    echo "Running: visualizations.R"
    Rscript scripts/visualizations.R --skip-apa 2>&1 | tee -a logs/visualizations_${TP}.log || echo "  Warning: visualizations.R had errors"

    echo "Running: tad_volcano_plot.R"
    if [ -f "tad_analysis/Bap1.diff.tad.txt" ]; then
        Rscript scripts/tad_volcano_plot.R tad_analysis/Bap1.diff.tad.txt --output outputs/tad_analysis/ 2>&1 | tee -a logs/tad_volcano_${TP}.log || true
    fi

    echo "Running: compartment_volcano_plot.R"
    if [ -f "tad_analysis/diffcompartments.txt" ]; then
        Rscript scripts/compartment_volcano_plot.R tad_analysis/diffcompartments.txt --output outputs/compartment_analysis/ 2>&1 | tee -a logs/compartment_volcano_${TP}.log || true
    fi

    echo "Running: downstream_analysis.R"
    Rscript scripts/downstream_analysis.R 2>&1 | tee -a logs/downstream_${TP}.log || echo "  Warning: downstream_analysis.R had errors"

    echo "Running: loop_distance_analysis.R"
    Rscript scripts/loop_distance_analysis.R 2>&1 | tee -a logs/loop_distance_${TP}.log || echo "  Warning: loop_distance_analysis.R had errors"

    echo "Running: annotate_loops_extended.R --timepoint $TP"
    Rscript scripts/annotate_loops_extended.R --timepoint $TP 2>&1 | tee -a logs/annotate_${TP}.log || true

    echo "Running: apa_analysis.R (all resolutions)"
    for RES in 5000 10000 25000; do
        echo "  Resolution: ${RES}bp"
        Rscript scripts/apa_analysis.R --resolution $RES 2>&1 | tee -a logs/apa_${RES}_${TP}.log || true
    done

    # --- Section 2: QC and Differential Analysis ---
    echo ""
    echo "=== Section 2: QC and Differential Analysis ($TP) ==="

    echo "Running: qc-val.R"
    for RES in 5000 10000 25000; do
        echo "  Resolution: ${RES}bp"
        Rscript scripts/qc-val.R $RES 2>&1 | tee -a logs/qc_${RES}_${TP}.log || true
    done

    echo "Running: edgeR.R"
    for RES in 5000 10000 25000; do
        echo "  Resolution: ${RES}bp"
        Rscript scripts/edgeR.R $RES 2>&1 | tee -a logs/edgeR_${RES}_${TP}.log || true
    done

    echo "Running: compare_resolutions.R"
    Rscript scripts/compare_resolutions.R 2>&1 | tee -a logs/compare_res_${TP}.log || true

    echo ""
    echo "=== Completed $TP timepoint ==="
}

# =============================================================================
# ALL SCRIPTS NOW OUTPUT MULTI-FORMAT (PDF + SVG + JPEG)
# =============================================================================
# Main Pipeline Scripts:
#   1. scripts/visualizations.R           - 10 plots
#   2. scripts/tad_volcano_plot.R         - 2 plots (relaxed + standard)
#   3. scripts/compartment_volcano_plot.R - 2 plots (relaxed + standard)
#   4. scripts/apa_analysis.R             - 5 plots per loop set
#   5. scripts/downstream_analysis.R      - 4 plots
#   6. scripts/loop_distance_analysis.R   - 9 plots
#   7. scripts/annotate_loops_extended.R  - 3 plots
#   8. scripts/qc-val.R                   - 9 plots (base R + pheatmap)
#   9. scripts/edgeR.R                    - 7 plots (base R + edgeR)
#  10. scripts/compare_resolutions.R      - 5 plots (Venn + ggplot2)
#
# Secondary Analysis Scripts:
#  11. stripes/scripts/stripe_visualizations.R  - 9 plots
#  12. stripes/scripts/phase3_edgeR.R           - 5 plots
#  13. tads/scripts/tad_visualizations.R        - 18+ plots
#  14. peaks/scripts/annotate_loops_extended.R  - 3 plots
#
# Total: ~90+ plots with native multi-format output
# =============================================================================

# =============================================================================
# MAIN EXECUTION: Run for each timepoint
# =============================================================================

for TP in "${TIMEPOINTS[@]}"; do
    run_for_timepoint "$TP"
done

# -----------------------------------------------------------------------------
# SECTION 3: STRIPES ANALYSIS (runs once - has its own output directories)
# -----------------------------------------------------------------------------

echo ""
echo "=== Section 3: Stripes Analysis ==="
echo ""

if [ -d "stripes/scripts" ]; then
    # edgeR for stripes
    echo "Running: stripes/phase3_edgeR.R"
    for TIMEPOINT in early late; do
        Rscript stripes/scripts/phase3_edgeR.R $TIMEPOINT 2>&1 | tee -a logs/stripes_edgeR_${TIMEPOINT}.log || true
    done

    # Stripe visualizations
    echo "Running: stripes/stripe_visualizations.R"
    Rscript stripes/scripts/stripe_visualizations.R 2>&1 | tee -a logs/stripe_viz.log || true
fi

# -----------------------------------------------------------------------------
# SECTION 4: TAD ANALYSIS
# -----------------------------------------------------------------------------

echo ""
echo "=== Section 4: TAD Analysis ==="
echo ""

if [ -d "tads/scripts" ]; then
    echo "Running: tads/tad_visualizations.R"
    for TIMEPOINT in early late; do
        Rscript tads/scripts/tad_visualizations.R $TIMEPOINT 2>&1 | tee -a logs/tad_viz_${TIMEPOINT}.log || true
    done
fi

# -----------------------------------------------------------------------------
# SECTION 5: PEAKS ANALYSIS
# -----------------------------------------------------------------------------

echo ""
echo "=== Section 5: Peaks Analysis ==="
echo ""

if [ -d "peaks/scripts" ]; then
    echo "Running: peaks/annotate_loops_extended.R"
    for VARIANT in late early; do
        Rscript peaks/scripts/annotate_loops_extended.R --timepoint $VARIANT 2>&1 | tee -a logs/peaks_${VARIANT}.log || true
    done
fi

# =============================================================================
# POST-PROCESSING: Organize Figures into Nested Folders
# =============================================================================
# Structure: {figure_name}/pdfs/{figure_name}.pdf
#            {figure_name}/jpgs/{figure_name}.jpg
#            {figure_name}/svgs/{figure_name}.svg

organize_figures() {
    local search_dir=$1
    local organized_count=0

    echo "  Organizing figures in: $search_dir"

    # Find all PDFs and organize related files
    find "$search_dir" -maxdepth 1 -name "*.pdf" -type f 2>/dev/null | while read pdf_file; do
        local dir_path=$(dirname "$pdf_file")
        local base_name=$(basename "$pdf_file" .pdf)
        local figure_dir="${dir_path}/${base_name}"

        # Skip if already organized (file is in a pdfs/ subfolder)
        if [[ "$dir_path" == */pdfs ]]; then
            continue
        fi

        # Check if corresponding files exist
        local jpg_file="${dir_path}/${base_name}.jpg"
        local svg_file="${dir_path}/${base_name}.svg"

        # Only organize if at least PDF exists (which it does if we're here)
        # Create figure directory and subdirectories
        mkdir -p "${figure_dir}/pdfs"
        mkdir -p "${figure_dir}/jpgs"
        mkdir -p "${figure_dir}/svgs"

        # Move files to their respective subdirectories
        mv "$pdf_file" "${figure_dir}/pdfs/" 2>/dev/null && \
            echo "    Moved: ${base_name}.pdf -> ${base_name}/pdfs/"

        if [ -f "$jpg_file" ]; then
            mv "$jpg_file" "${figure_dir}/jpgs/" 2>/dev/null && \
                echo "    Moved: ${base_name}.jpg -> ${base_name}/jpgs/"
        fi

        if [ -f "$svg_file" ]; then
            mv "$svg_file" "${figure_dir}/svgs/" 2>/dev/null && \
                echo "    Moved: ${base_name}.svg -> ${base_name}/svgs/"
        fi

        organized_count=$((organized_count + 1))
    done

    echo "  Organized $organized_count figure(s) in $search_dir"
}

echo ""
echo "=== Post-Processing: Organizing Figures into Nested Folders ==="
echo ""

# Organize figures in each output directory
for TP in "${TIMEPOINTS[@]}"; do
    output_dir="${OUTPUT_DIRS[$TP]}"
    if [ -d "$output_dir" ]; then
        echo "Processing $TP outputs ($output_dir)..."

        # Find all subdirectories that contain figures and organize them
        find "$output_dir" -type d | while read subdir; do
            # Check if directory contains PDFs at this level
            if ls "$subdir"/*.pdf 1>/dev/null 2>&1; then
                organize_figures "$subdir"
            fi
        done
    fi
done

# Also organize stripes, tads, and peaks output directories
for analysis_dir in "stripes/results" "tads/results" "peaks/results"; do
    if [ -d "$analysis_dir" ]; then
        echo "Processing $analysis_dir..."
        find "$analysis_dir" -type d | while read subdir; do
            if ls "$subdir"/*.pdf 1>/dev/null 2>&1; then
                organize_figures "$subdir"
            fi
        done
    fi
done

# =============================================================================
# POST-PROCESSING: Optional Conversion for Legacy PDFs
# =============================================================================
# Note: All scripts now output PDF + SVG + JPEG natively.
# This section is only needed for legacy PDFs that were created before
# the multi-format conversion.

echo ""
echo "=== Post-Processing: Checking for Legacy PDFs ==="
echo ""

# Check if ImageMagick is available for converting any legacy PDFs
if command -v convert &> /dev/null; then
    # Find PDFs without corresponding JPEGs and convert them
    legacy_count=0
    find . -name "*.pdf" -type f | while read pdf; do
        # Skip already-organized files
        if [[ "$pdf" == */pdfs/* ]]; then
            continue
        fi
        jpg="${pdf%.pdf}.jpg"
        # Convert to JPEG if not exists
        if [ ! -f "$jpg" ]; then
            convert -density 300 "$pdf" -quality 95 "$jpg" 2>/dev/null && \
                echo "  Converted legacy: $(basename $pdf) -> jpg" && \
                legacy_count=$((legacy_count + 1)) || true
        fi
    done
    if [ "$legacy_count" -eq 0 ]; then
        echo "No legacy PDFs found - all outputs have native multi-format versions."
    fi
else
    echo "ImageMagick not found (optional - only needed for legacy PDFs)."
fi

# =============================================================================
# SUMMARY
# =============================================================================

echo ""
echo "=========================================="
echo "Figure Regeneration Complete"
echo "=========================================="
echo "End time: $(date)"
echo ""

echo "Output counts per timepoint:"
for TP in "${TIMEPOINTS[@]}"; do
    output_dir="${OUTPUT_DIRS[$TP]}"
    if [ -d "$output_dir" ]; then
        echo "  $TP ($output_dir):"
        echo "    PDFs: $(find "$output_dir" -name '*.pdf' -type f 2>/dev/null | wc -l | tr -d ' ')"
        echo "    SVGs: $(find "$output_dir" -name '*.svg' -type f 2>/dev/null | wc -l | tr -d ' ')"
        echo "    JPEGs: $(find "$output_dir" -name '*.jpg' -type f 2>/dev/null | wc -l | tr -d ' ')"
    fi
done

echo ""
echo "All scripts now output native multi-format (PDF+SVG+JPEG):"
echo "  Main pipeline: visualizations.R, tad_volcano_plot.R, compartment_volcano_plot.R,"
echo "                 apa_analysis.R, downstream_analysis.R, loop_distance_analysis.R,"
echo "                 annotate_loops_extended.R, qc-val.R, edgeR.R, compare_resolutions.R"
echo "  Stripes:       stripe_visualizations.R, phase3_edgeR.R"
echo "  TADs:          tad_visualizations.R"
echo "  Peaks:         annotate_loops_extended.R"

echo ""
echo "Done!"
