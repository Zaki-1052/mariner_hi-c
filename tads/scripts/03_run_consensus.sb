#!/bin/bash
#SBATCH --job-name=consensus_tads
#SBATCH --output=logs/consensus_%j.out
#SBATCH --partition=shared
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=04:00:00
#SBATCH --account=csd940

# 03_run_consensus.sh
# ConsensusTADs for replicate robustness assessment

echo "========================================="
echo "TADCompare Pipeline - Step 3: ConsensusTADs"
echo "========================================="
echo "Job ID: $SLURM_JOB_ID"
echo "Node: $HOSTNAME"
echo "Start time: $(date)"
echo "========================================="
echo ""

source ~/.bashrc
conda activate mariner_env

echo "Environment check:"
which R
R --version | head -n 1
echo ""

echo "Starting ConsensusTADs analysis..."
cd /expanse/lustre/projects/csd940/zalibhai/mariner_hi-c/tads
Rscript scripts/03_run_consensus.R

if [ $? -eq 0 ]; then
    echo ""
    echo "✅ ConsensusTADs analysis completed successfully"
else
    echo ""
    echo "❌ ConsensusTADs analysis failed with exit code $?"
fi

echo ""
echo "End time: $(date)"
echo "========================================="
