#!/bin/bash
#SBATCH --job-name=tad_postprocess
#SBATCH --output=logs/postprocess_%j.out
#SBATCH --partition=shared
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --mem=8G
#SBATCH --time=01:00:00
#SBATCH --account=csd940

# 04_postprocess.sh
# Calculate shift distances using bedtools, then run R analysis script

echo "========================================="
echo "TADCompare Pipeline - Step 4: Post-processing"
echo "========================================="
echo "Job ID: $SLURM_JOB_ID"
echo "Node: $HOSTNAME"
echo "Start time: $(date)"
echo "========================================="
echo ""

source ~/.bashrc
conda activate mariner_env

echo "Environment check:"
which bedtools
bedtools --version
which R
echo ""

# === Configuration ===
RESOLUTION=25000
BASE_DIR="/expanse/lustre/projects/csd940/zalibhai/mariner_hi-c/tads"
CONSENSUS_DIR="${BASE_DIR}/results/consensus"
TADCOMPARE_DIR="${BASE_DIR}/results/tadcompare"
FINAL_DIR="${BASE_DIR}/results/final"
TMP_DIR="${FINAL_DIR}/tmp"

mkdir -p "${FINAL_DIR}" "${TMP_DIR}"

# === Determine input file ===
if [ -f "${CONSENSUS_DIR}/tadcompare_with_robustness.tsv" ]; then
    INPUT_FILE="${CONSENSUS_DIR}/tadcompare_with_robustness.tsv"
    echo "Using: robustness-annotated file"
else
    INPUT_FILE="${TADCOMPARE_DIR}/tadcompare_all_boundaries.tsv"
    echo "Using: original TADCompare file"
fi
echo ""

# === Extract boundaries by enrichment direction ===
echo "Extracting boundaries for bedtools..."

# Control-enriched (Matrix 1)
awk -F'\t' 'NR>1 && $7=="Matrix 1" {
    print $1"\t"$2"\t"$2+'${RESOLUTION}'"\t"NR
}' "${INPUT_FILE}" > "${TMP_DIR}/ctrl_boundaries.bed"

# Mutant-enriched (Matrix 2)
awk -F'\t' 'NR>1 && $7=="Matrix 2" {
    print $1"\t"$2"\t"$2+'${RESOLUTION}'"\t"NR
}' "${INPUT_FILE}" > "${TMP_DIR}/mut_boundaries.bed"

echo "  Control-enriched: $(wc -l < ${TMP_DIR}/ctrl_boundaries.bed)"
echo "  Mutant-enriched: $(wc -l < ${TMP_DIR}/mut_boundaries.bed)"

# Sort for bedtools
sort -k1,1 -k2,2n "${TMP_DIR}/ctrl_boundaries.bed" > "${TMP_DIR}/ctrl_boundaries.sorted.bed"
sort -k1,1 -k2,2n "${TMP_DIR}/mut_boundaries.bed" > "${TMP_DIR}/mut_boundaries.sorted.bed"

# === Calculate shift distances with bedtools closest ===
echo ""
echo "Running bedtools closest..."

bedtools closest -a "${TMP_DIR}/ctrl_boundaries.sorted.bed" \
                 -b "${TMP_DIR}/mut_boundaries.sorted.bed" \
                 -d -t first \
                 > "${TMP_DIR}/ctrl_to_mut_distances.txt" 2>/dev/null

bedtools closest -a "${TMP_DIR}/mut_boundaries.sorted.bed" \
                 -b "${TMP_DIR}/ctrl_boundaries.sorted.bed" \
                 -d -t first \
                 > "${TMP_DIR}/mut_to_ctrl_distances.txt" 2>/dev/null

echo "  ✓ Distance calculations complete"

# === Run R analysis script ===
echo ""
echo "Running R analysis..."
cd "${BASE_DIR}"
Rscript scripts/04_analyze_shifts.R

R_EXIT=$?

# === Cleanup ===
echo ""
echo "Cleaning up temporary files..."
rm -rf "${TMP_DIR}"

# === Summary ===
echo ""
echo "========================================="
echo "Final outputs:"
ls -lh "${FINAL_DIR}"/*.{tsv,bed,txt} 2>/dev/null
echo ""

if [ ${R_EXIT} -eq 0 ]; then
    echo "✅ Post-processing completed successfully"
else
    echo "❌ Post-processing failed with exit code ${R_EXIT}"
fi

echo ""
echo "End time: $(date)"
echo "========================================="
