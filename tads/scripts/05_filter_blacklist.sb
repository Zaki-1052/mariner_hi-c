#!/bin/bash
#SBATCH --job-name=filter_blacklist
#SBATCH --output=logs/filter_blacklist_%j.out
#SBATCH --partition=shared
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --mem=8G
#SBATCH --time=00:30:00
#SBATCH --account=csd940

# 05_filter_blacklist.sb
# Post-filter TADCompare results to remove boundaries in blacklisted regions
# TADCompare does not have native blacklist support
# Usage: sbatch scripts/05_filter_blacklist.sb

echo "========================================="
echo "TADCompare Pipeline - Step 5: Blacklist Filtering"
echo "========================================="
echo "Job ID: $SLURM_JOB_ID"
echo "Node: $HOSTNAME"
echo "Start time: $(date)"
echo "========================================="
echo ""

source ~/.bashrc
conda activate mariner_env

echo "Environment check:"
which R
R --version | head -1
echo ""

# === Configuration ===
BASE_DIR="/expanse/lustre/projects/csd940/zalibhai/mariner_hi-c/tads"
BLACKLIST_FILE="/expanse/lustre/projects/csd940/ctea/HiC/dchic/250123blacklist.bed"

echo "Base directory: ${BASE_DIR}"
echo "Blacklist file: ${BLACKLIST_FILE}"
echo ""

# Check blacklist exists
if [ ! -f "${BLACKLIST_FILE}" ]; then
    echo "ERROR: Blacklist file not found: ${BLACKLIST_FILE}"
    exit 1
fi

# Check blacklist stats
echo "Blacklist file stats:"
wc -l "${BLACKLIST_FILE}"
echo ""

# Create logs directory if needed
mkdir -p "${BASE_DIR}/logs"

# Run R script
cd "${BASE_DIR}"
echo "Running blacklist filtering..."
echo ""

Rscript scripts/05_filter_blacklist.R

EXIT_CODE=$?

echo ""
echo "========================================="
echo "Filtering complete!"
echo "Exit code: ${EXIT_CODE}"
echo "End time: $(date)"
echo "========================================="

exit ${EXIT_CODE}
