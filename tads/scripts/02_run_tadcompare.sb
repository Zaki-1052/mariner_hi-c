#!/bin/bash
#SBATCH --job-name=tadcompare
#SBATCH --output=logs/tadcompare_%j.out
#SBATCH --partition=shared
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=04:00:00
#SBATCH --account=csd940

# 02_run_tadcompare.sb
# TADCompare differential boundary analysis: Control vs BAP1-KO mutant
# Usage: bash scripts/02_run_tadcompare.sb [timepoint]
#   timepoint: "late" (default) or "early"

TIMEPOINT="${1:-late}"

echo "========================================="
echo "TADCompare Pipeline - Step 2: Differential Analysis"
echo "========================================="
echo "Job ID: $SLURM_JOB_ID"
echo "Node: $HOSTNAME"
echo "Timepoint: ${TIMEPOINT}"
echo "Start time: $(date)"
echo "========================================="
echo ""

source ~/.bashrc
conda activate mariner_env

echo "Environment check:"
which R
R --version | head -n 1
echo ""

echo "Starting TADCompare analysis for ${TIMEPOINT} timepoint..."
cd /expanse/lustre/projects/csd940/zalibhai/mariner_hi-c/tads
Rscript scripts/02_run_tadcompare.R "${TIMEPOINT}"

if [ $? -eq 0 ]; then
    echo ""
    echo "✅ TADCompare analysis completed successfully"
else
    echo ""
    echo "❌ TADCompare analysis failed with exit code $?"
fi

echo ""
echo "End time: $(date)"
echo "========================================="
