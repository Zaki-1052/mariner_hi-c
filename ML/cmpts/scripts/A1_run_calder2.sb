#!/bin/bash
# ML/cmpts/scripts/A1_run_calder2.sb
# Stage A1: Run CALDER2 subcompartment calling on a single sample.
# Usage: sbatch A1_run_calder2.sb <timepoint> <sample>
#   <timepoint> : 250402 | 250831
#   <sample>    : ctrl_merged | mut_merged
#SBATCH --job-name=calder2
#SBATCH --output=calder2_%j.out
#SBATCH --partition=shared
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=12:00:00
#SBATCH --account=csd940

TP="${1:?usage: sbatch A1_run_calder2.sb <timepoint> <sample>}"
SAMPLE="${2:?usage: sbatch A1_run_calder2.sb <timepoint> <sample>}"

CODE_DIR="/expanse/lustre/projects/csd940/zalibhai/mariner_hi-c/ML/cmpts"
DATA_DIR="/expanse/lustre/projects/csd940/zalibhai/sniper"
HIC_ROOT="/expanse/lustre/projects/csd940/zalibhai/stripes/StripeCaller/data/hic"

HIC="${HIC_ROOT}/${TP}/${SAMPLE}.hic"
WORK_DIR="${DATA_DIR}/calder2/${TP}/${SAMPLE}"

mkdir -p "${WORK_DIR}" "${CODE_DIR}/logs" "${CODE_DIR}/outputs/calder2/${TP}/${SAMPLE}"

echo "==========================================="
echo "A1: CALDER2 Subcompartment Calling"
echo "==========================================="
echo "Job ID:     ${SLURM_JOB_ID}"
echo "Node:       ${HOSTNAME}"
echo "CPUs:       ${SLURM_CPUS_PER_TASK}"
echo "Timepoint:  ${TP}"
echo "Sample:     ${SAMPLE}"
echo "Input:      ${HIC}"
echo "Work dir:   ${WORK_DIR}"
echo "Repo dir:   ${CODE_DIR}/outputs/calder2/${TP}/${SAMPLE}"
echo "Start:      $(date)"
echo "==========================================="

if [ ! -s "${HIC}" ]; then
  echo "ERROR: missing or empty .hic: ${HIC}" >&2
  exit 2
fi

source ~/.bashrc
conda activate calder2_env

Rscript --vanilla "${CODE_DIR}/scripts/A1_run_calder2.R" "${TP}" "${SAMPLE}" "${DATA_DIR}" "${CODE_DIR}"
STATUS=$?

if [ ${STATUS} -ne 0 ]; then
  echo "ERROR: A1_run_calder2.R failed (exit=${STATUS})." >&2
  exit 1
fi

echo ""
echo "End: $(date)"
echo "==========================================="
