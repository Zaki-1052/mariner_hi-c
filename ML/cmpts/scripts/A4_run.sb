#!/bin/bash
# ML/cmpts/scripts/A4_run.sb
# Stage A4: HOMER A/B x CALDER2 subcompartment integration.
# Processes both timepoints in a single job.
# Usage: sbatch A4_run.sb
#SBATCH --job-name=a4_homer_integration
#SBATCH --output=logs/a4_homer_integration_%j.out
#SBATCH --partition=shared
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=02:00:00
#SBATCH --account=csd940

CODE_DIR="/expanse/lustre/projects/csd940/zalibhai/mariner_hi-c/ML/cmpts"
DATA_DIR="/expanse/lustre/projects/csd940/zalibhai/sniper"

mkdir -p "${CODE_DIR}/logs" "${CODE_DIR}/outputs/integration/late" "${CODE_DIR}/outputs/integration/early"

echo "==========================================="
echo "A4: HOMER A/B x CALDER2 Integration"
echo "==========================================="
echo "Job ID:     ${SLURM_JOB_ID}"
echo "Node:       ${HOSTNAME}"
echo "CPUs:       ${SLURM_CPUS_PER_TASK}"
echo "Start:      $(date)"
echo "Code dir:   ${CODE_DIR}"
echo "==========================================="

source ~/.bashrc
conda activate calder2_env

Rscript "${CODE_DIR}/scripts/A4_integrate_homer_compartments.R" \
  "${DATA_DIR}" "${CODE_DIR}"
STATUS=$?

if [ ${STATUS} -ne 0 ]; then
  echo "ERROR: A4_integrate_homer_compartments.R failed (exit=${STATUS})." >&2
  exit 1
fi

echo ""
echo "End: $(date)"
echo "==========================================="
