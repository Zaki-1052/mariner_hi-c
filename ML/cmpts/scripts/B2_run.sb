#!/bin/bash
# ML/cmpts/scripts/B2_run.sb
# Stage B2: Generate SNIPER training labels from CALDER2 subcompartment calls.
# Usage: sbatch B2_run.sb <timepoint>
#   <timepoint> : 250402 | 250831
#SBATCH --job-name=b2_labels
#SBATCH --output=logs/b2_labels_%j.out
#SBATCH --partition=shared
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=01:00:00
#SBATCH --account=csd940

TP="${1:?usage: sbatch B2_run.sb <timepoint>}"

CODE_DIR="/expanse/lustre/projects/csd940/zalibhai/mariner_hi-c/ML/cmpts"
DATA_DIR="/expanse/lustre/projects/csd940/zalibhai/sniper"

case "${TP}" in
  250402) TP_DIR="late" ;;
  250831) TP_DIR="early" ;;
  *) echo "ERROR: Unknown timepoint ${TP}" >&2; exit 1 ;;
esac

TSV="${CODE_DIR}/outputs/calder2/${TP_DIR}/${TP}/ctrl_merged/sub_compartments/all_sub_compartments.tsv"
CROP="${CODE_DIR}/repos/SNIPER/crop_map/mm10_cropIndices_${TP}.mat"

mkdir -p "${CODE_DIR}/outputs/sniper" "${CODE_DIR}/logs"

echo "==========================================="
echo "B2: SNIPER Labels from CALDER2"
echo "==========================================="
echo "Job ID:     ${SLURM_JOB_ID}"
echo "Node:       ${HOSTNAME}"
echo "Timepoint:  ${TP} (${TP_DIR})"
echo "CALDER2:    ${TSV}"
echo "Crop idx:   ${CROP}"
echo "Output:     ${CODE_DIR}/outputs/sniper/mm10_labels_${TP}.mat"
echo "Start:      $(date)"
echo "==========================================="

if [ ! -s "${TSV}" ]; then
  echo "ERROR: missing or empty CALDER2 TSV: ${TSV}" >&2
  exit 2
fi

if [ ! -f "${CROP}" ]; then
  echo "ERROR: crop indices not found: ${CROP}" >&2
  exit 2
fi

source ~/.bashrc
conda activate sniper_env

python "${CODE_DIR}/scripts/B2_generate_labels_from_calder2.py" \
  "${TP}" "${DATA_DIR}" "${CODE_DIR}"

STATUS=$?

if [ ${STATUS} -ne 0 ]; then
  echo "ERROR: B2_generate_labels_from_calder2.py failed (exit=${STATUS})." >&2
  exit 1
fi

echo ""
echo "End: $(date)"
echo "==========================================="
