#!/bin/bash
# ML/cmpts/scripts/A2_run.sb
# Stage A2: Differential subcompartment analysis for a single timepoint.
# Usage: sbatch A2_run.sb <timepoint>
#   <timepoint> : 250402 | 250831
#SBATCH --job-name=a2_diff_subcomp
#SBATCH --output=a2_diff_subcomp_%j.out
#SBATCH --partition=shared
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=02:00:00
#SBATCH --account=csd940

TP="${1:?usage: sbatch A2_run.sb <timepoint>}"

CODE_DIR="/expanse/lustre/projects/csd940/zalibhai/mariner_hi-c/ML/cmpts"
DATA_DIR="/expanse/lustre/projects/csd940/zalibhai/sniper"

mkdir -p "${CODE_DIR}/logs" "${CODE_DIR}/outputs/calder2"

echo "==========================================="
echo "A2: Differential Subcompartment Analysis"
echo "==========================================="
echo "Job ID:     ${SLURM_JOB_ID}"
echo "Node:       ${HOSTNAME}"
echo "CPUs:       ${SLURM_CPUS_PER_TASK}"
echo "Timepoint:  ${TP}"
echo "Start:      $(date)"
echo "Code dir:   ${CODE_DIR}"
echo "==========================================="

source ~/.bashrc
conda activate calder2_env

Rscript --vanilla -e "
  if (!requireNamespace('ggalluvial', quietly=TRUE)) {
    install.packages('ggalluvial', repos='https://cloud.r-project.org')
  }
  if (!requireNamespace('svglite', quietly=TRUE)) {
    install.packages('svglite', repos='https://cloud.r-project.org')
  }
  cat('Package check complete\n')
"

Rscript --vanilla "${CODE_DIR}/scripts/A2_differential_subcompartments.R" \
  "${TP}" "${DATA_DIR}" "${CODE_DIR}"
STATUS=$?

if [ ${STATUS} -ne 0 ]; then
  echo "ERROR: A2_differential_subcompartments.R failed (exit=${STATUS})." >&2
  exit 1
fi

echo ""
echo "End: $(date)"
echo "==========================================="
