#!/bin/bash
#SBATCH --job-name=loopbin_mm10
#SBATCH --output=logs/loopbin_%j.out
#SBATCH --time=12:00:00
#SBATCH --mem=64G
#SBATCH --cpus-per-task=8
#SBATCH --partition=shared
#SBATCH --account=csd940
#SBATCH --nodes=1
#SBATCH --ntasks=1

# ============================================================
# LoopBin Pipeline for mm10 Control Data
# ============================================================

#set -e  # Exit on error

# === PATHS ===
WORKDIR="/expanse/lustre/projects/csd940/zalibhai/loop-class"
LOOPBIN="${WORKDIR}/LoopBin"
MCOOL="${WORKDIR}/ctrl_merged.mcool"
H3K27AC_BW="${WORKDIR}/H3K27ac_ctrl_merged.bw"
H3K27ME3_BW="${WORKDIR}/H3K27me3_ctrl_merged.bw"
LOOPS_RAW="/expanse/lustre/projects/csd940/zalibhai/mariner_hi-c/25042-late_outputs/merged_loops/non_redundant_loops.bedpe"

# Output directories
OUTDIR="${WORKDIR}/loopbin_output"
BEDGRAPH_DIR="${OUTDIR}/bedgraphs"
PROCESSED_DIR="${OUTDIR}/processed"
PRETRAIN_DIR="${OUTDIR}/pretrain/"
TRAIN_DIR="${OUTDIR}/train/"

mkdir -p "${OUTDIR}/logs"
mkdir -p "${BEDGRAPH_DIR}"
mkdir -p "${PROCESSED_DIR}/ctrl"
mkdir -p "${PRETRAIN_DIR}"
mkdir -p "${TRAIN_DIR}"

cd "${LOOPBIN}"

# === SETUP CONDA ===
source ~/.bashrc
conda activate loopbin

echo "============================================================"
echo "LoopBin Pipeline Started: $(date)"
echo "============================================================"
echo "Working directory: ${WORKDIR}"
echo "mcool: ${MCOOL}"
echo "Bigwigs: H3K27ac, H3K27me3"
echo ""

# === STEP 0: Prepare clean BEDPE ===
echo "=== Step 0: Preparing clean BEDPE file ==="
LOOPS_CLEAN="${OUTDIR}/loops_clean.bedpe"
cut -f1-6 "${LOOPS_RAW}" > "${LOOPS_CLEAN}"
NLOOPS=$(wc -l < "${LOOPS_CLEAN}")
echo "  Prepared ${NLOOPS} loops"
echo ""

# === STEP 1: Preprocess bigwigs to bedgraph ===
echo "=== Step 1: Preprocessing bigwigs → bedgraphs ==="

echo "  Processing H3K27ac..."
bash src/preprocess_local_mm10.sh \
    "${H3K27AC_BW}" \
    H3K27ac \
    "${BEDGRAPH_DIR}" \
    "${LOOPBIN}/src/fn"

echo "  Processing H3K27me3..."
bash src/preprocess_local_mm10.sh \
    "${H3K27ME3_BW}" \
    H3K27me3 \
    "${BEDGRAPH_DIR}" \
    "${LOOPBIN}/src/fn"

echo "  Bedgraph files created:"
ls -la "${BEDGRAPH_DIR}"/*.bedgraph | head -10
echo "  Total bedgraph files: $(ls ${BEDGRAPH_DIR}/*.bedgraph | wc -l)"
echo ""

# === STEP 2: Process input data ===
echo "=== Step 2: Processing input data ==="
echo "  Combining loops + mcool + bedgraphs..."

python main.py -f process \
    -l "${LOOPS_CLEAN}" \
    -c "${MCOOL}" \
    -g "${BEDGRAPH_DIR}" \
    -r ${SLURM_CPUS_PER_TASK} \
    -u "${PROCESSED_DIR}/ctrl" \
    -p H3K27ac,H3K27me3

echo "  Processed raw data:"
ls -la "${PROCESSED_DIR}/ctrl/"
ls -la "${PROCESSED_DIR}/ctrl/raw/"
echo ""

# === STEP 2b: Normalize (creates merged_log_data.npy) ===
echo "=== Step 2b: Normalizing and creating training input ==="

python main.py -f normalize \
    -e ctrl \
    -u "${PROCESSED_DIR}"

echo "  Normalized data created:"
ls -la "${PROCESSED_DIR}/merged_log_data.npy"
PROCESSED_DATA="${PROCESSED_DIR}/merged_log_data.npy"
echo ""

# === STEP 3: Pretrain the autoencoder ===
echo "=== Step 3: Pretraining autoencoder ==="
echo "  Input: ${PROCESSED_DATA}"

python main.py -f pretrain \
    -d "${PROCESSED_DATA}" \
    -u "${PRETRAIN_DIR}"

echo "  Pretrained model output:"
ls -la "${PRETRAIN_DIR}"
echo ""

# === STEP 4: Train VaDE model ===
echo "=== Step 4: Training VaDE model ==="
echo "  Using pretrained model: ${PRETRAIN_DIR}"

# Train with max 10 clusters (VaDE will auto-reduce redundant ones)
python main.py -f train \
    -num 10 \
    -d "${PROCESSED_DATA}" \
    -if_pre True \
    -pre "${PRETRAIN_DIR}" \
    -ep 2000 \
    -u "${TRAIN_DIR}" \
    -p H3K27ac,H3K27me3

echo ""
echo "============================================================"
echo "LoopBin Pipeline Complete: $(date)"
echo "============================================================"
echo ""
echo "Output locations:"
echo "  Bedgraphs:       ${BEDGRAPH_DIR}/"
echo "  Processed data:  ${PROCESSED_DIR}/"
echo "  Training input:  ${PROCESSED_DATA}"
echo "  Pretrained:      ${PRETRAIN_DIR}"
echo "  Final results:   ${TRAIN_DIR}"
echo ""
echo "Key output files:"
echo "  Cluster labels:  ${TRAIN_DIR}/labels.npy"
echo "  Labeled loops:   ${TRAIN_DIR}/labels_loops.bedpe"
echo "  Cluster plot:    ${TRAIN_DIR}/all_clusters.pdf"
echo "  t-SNE plot:      ${TRAIN_DIR}/tsne_perplex100.pdf"
echo ""
ls -la "${TRAIN_DIR}"
