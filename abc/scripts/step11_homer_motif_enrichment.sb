#!/bin/bash
#SBATCH --job-name=homer_motif
#SBATCH --output=logs/homer_motif_%j.out
#SBATCH --partition=shared
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=08:00:00
#SBATCH --account=csd940

echo "========================================="
echo "HOMER Motif Enrichment - Enhancer Subsets"
echo "========================================="
echo "Job ID: $SLURM_JOB_ID"
echo "Node: $HOSTNAME"
echo "Start time: $(date)"
echo "========================================="
echo ""

source ~/.bashrc
source activate homer1

# Configuration
BASE_DIR="/expanse/lustre/projects/csd940/zalibhai/mariner_hi-c"
BED_DIR="${BASE_DIR}/abc/results/enhancer_subset_analysis/beds_for_homer"
OUTPUT_BASE="${BASE_DIR}/abc/results/enhancer_subset_analysis/homer_results"
GENOME="mm10"
CPUS=${SLURM_CPUS_PER_TASK:-8}

echo "Configuration:"
echo "  BED dir:     ${BED_DIR}"
echo "  Output base: ${OUTPUT_BASE}"
echo "  Genome:      ${GENOME}"
echo "  CPUs:        ${CPUS}"
echo ""

# Validate all 6 required BED files
REQUIRED_BEDS=(
    "Activity_Lost.bed"
    "K119ub_Only.bed"
    "Activity_Gain.bed"
    "Stable.bed"
    "K119ub_Only_T1_low.bed"
    "K119ub_Only_T3_high.bed"
)

echo "Input validation:"
MISSING=0
for BED in "${REQUIRED_BEDS[@]}"; do
    BED_PATH="${BED_DIR}/${BED}"
    if [ ! -s "${BED_PATH}" ]; then
        echo "  ERROR: Missing or empty: ${BED_PATH}"
        MISSING=$((MISSING + 1))
    else
        COUNT=$(wc -l < "${BED_PATH}")
        echo "  ${BED}: ${COUNT} regions"
    fi
done

if [ ${MISSING} -gt 0 ]; then
    echo ""
    echo "ERROR: ${MISSING} required BED file(s) missing. Exiting."
    exit 1
fi
echo ""

# Create output directory
mkdir -p "${OUTPUT_BASE}"

# Define 4 HOMER comparisons: target|background|output_dir|extra_flags
COMPARISONS=(
    "Activity_Lost.bed|Stable.bed|Activity_Lost_vs_Stable|"
    "K119ub_Only.bed|Stable.bed|K119ub_Only_vs_Stable|"
    "Activity_Gain.bed|Stable.bed|Activity_Gain_vs_Stable|"
    "K119ub_Only_T3_high.bed|K119ub_Only_T1_low.bed|T3_high_vs_T1_low|-h"
)

FAILED=0
TOTAL=${#COMPARISONS[@]}

for i in "${!COMPARISONS[@]}"; do
    IFS='|' read -r TARGET BG OUTDIR EXTRA <<< "${COMPARISONS[$i]}"
    RUN_NUM=$((i + 1))

    echo "========================================="
    echo "Run ${RUN_NUM}/${TOTAL}: ${OUTDIR}"
    echo "========================================="
    echo "  Target:     ${TARGET}"
    echo "  Background: ${BG}"
    echo "  Extra flags: ${EXTRA:-none}"
    echo "  Start: $(date)"
    echo ""

    OUTPATH="${OUTPUT_BASE}/${OUTDIR}"

    findMotifsGenome.pl \
        "${BED_DIR}/${TARGET}" \
        "${GENOME}" \
        "${OUTPATH}" \
        -bg "${BED_DIR}/${BG}" \
        -size given \
        -mask \
        -p ${CPUS} \
        ${EXTRA}

    EXIT_CODE=$?

    if [ ${EXIT_CODE} -ne 0 ]; then
        echo "  FAILED (exit code ${EXIT_CODE})"
        FAILED=$((FAILED + 1))
    else
        echo "  Complete: $(date)"
    fi
    echo ""
done

# Results summary
echo "========================================="
echo "Results Summary"
echo "========================================="
echo ""

for i in "${!COMPARISONS[@]}"; do
    IFS='|' read -r TARGET BG OUTDIR EXTRA <<< "${COMPARISONS[$i]}"
    OUTPATH="${OUTPUT_BASE}/${OUTDIR}"
    KNOWN="${OUTPATH}/knownResults.txt"

    echo "--- ${OUTDIR} ---"

    if [ -f "${KNOWN}" ]; then
        # Count significant known motifs (q-value < 0.05, column 6)
        SIG_COUNT=$(awk -F'\t' 'NR>1 && $6+0 < 0.05' "${KNOWN}" | wc -l | tr -d ' ')
        echo "  Significant known motifs (q < 0.05): ${SIG_COUNT}"

        echo "  Top 5 known motifs:"
        awk -F'\t' 'NR>1 && NR<=6 {printf "    %s  p=%s  q=%s\n", $1, $3, $6}' "${KNOWN}"

        # Count de novo motifs
        DENOVO_COUNT=$(ls "${OUTPATH}"/homerResults/motif*.motif 2>/dev/null | wc -l | tr -d ' ')
        echo "  De novo motifs found: ${DENOVO_COUNT}"
    else
        echo "  WARNING: knownResults.txt not found"
    fi
    echo ""
done

echo "========================================="
if [ ${FAILED} -eq 0 ]; then
    echo "All ${TOTAL} HOMER runs completed successfully."
else
    echo "${FAILED}/${TOTAL} HOMER runs FAILED."
fi
echo ""
echo "Output directory: ${OUTPUT_BASE}"
echo ""
echo "Next steps:"
echo "  1. Review HTML reports: \${OUTPUT_BASE}/*/knownResults.html"
echo "  2. Transfer results to local:"
echo "     scp -r expanse:${OUTPUT_BASE} abc/results/enhancer_subset_analysis/"
echo "  3. Check K119ub_Only_vs_Stable for Polycomb-related motifs (SUZ12, EZH2, REST)"
echo "  4. Compare T3_high_vs_T1_low for dose-dependent TF differences"
echo ""
echo "End time: $(date)"
echo "========================================="

exit ${FAILED}
