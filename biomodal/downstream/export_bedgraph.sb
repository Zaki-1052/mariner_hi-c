#!/bin/bash
#SBATCH --job-name=export_bedgraph
#SBATCH --output=logs/export_bedgraph_%j.out
#SBATCH --partition=shared
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64G
#SBATCH --time=12:00:00
#SBATCH --account=csd940

# Export per-sample mC and hmC bedGraphs from Zarr store for genome browser visualization
# Usage: sbatch export_bedgraph.sb

mkdir -p logs

echo "========================================="
echo "Zarr to bedGraph Export (mC + hmC)"
echo "========================================="
echo "Job ID: $SLURM_JOB_ID"
echo "Node: $HOSTNAME"
echo "Start time: $(date)"
echo "========================================="
echo ""

source ~/.bashrc
conda activate modality

ZARR="/expanse/lustre/projects/csd940/zalibhai/biomodal/evoC-run/output/duet-1.5.0_evoC_Bap1_run_6bp/sample_outputs/zarr_store/CG/evoC_Bap1_run.genome.GRCm38_primary_assembly.dedup.CG.zarrz"
OUTDIR="/expanse/lustre/projects/csd940/zalibhai/biomodal/modality/exports/bedgraph"

mkdir -p "${OUTDIR}/mc" "${OUTDIR}/hmc"

echo "Zarr: ${ZARR}"
echo "Output: ${OUTDIR}"
echo ""

# Export mC bedGraphs (one per sample)
echo "--- Exporting mC bedGraphs ---"
modality export bedgraph \
  --zarr-path "${ZARR}" \
  --modification-count-column mc \
  --denominator-column total_c \
  --tag genome \
  --skip-rows-zero-counts \
  --tabix \
  --output-dir "${OUTDIR}/mc"

echo ""
echo "mC export complete: $(ls -1 ${OUTDIR}/mc/*.gz 2>/dev/null | wc -l) files"
echo ""

# Export hmC bedGraphs (one per sample)
echo "--- Exporting hmC bedGraphs ---"
modality export bedgraph \
  --zarr-path "${ZARR}" \
  --modification-count-column hmc \
  --denominator-column total_c \
  --tag genome \
  --skip-rows-zero-counts \
  --tabix \
  --output-dir "${OUTDIR}/hmc"

echo ""
echo "hmC export complete: $(ls -1 ${OUTDIR}/hmc/*.gz 2>/dev/null | wc -l) files"
echo ""

echo "========================================="
echo "Export complete"
echo "mC bedGraphs:  ${OUTDIR}/mc/"
echo "hmC bedGraphs: ${OUTDIR}/hmc/"
echo "End time: $(date)"
echo "========================================="
