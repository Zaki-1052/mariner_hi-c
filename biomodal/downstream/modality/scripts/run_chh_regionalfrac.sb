#!/bin/bash
#SBATCH --job-name=chh_regfrac
#SBATCH --output=logs/chh_regfrac_mecp2_%j.out
#SBATCH --partition=shared
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=240G
#SBATCH --time=02:00:00
#SBATCH --account=csd940

# CHH regional-frac at MeCP2 peaks — OOM at 128GB, retry with 240GB
# Usage: sbatch run_chh_regionalfrac.sb

source ~/.bashrc
conda activate modality

cd /expanse/lustre/projects/csd940/zalibhai/biomodal/modality
mkdir -p logs

echo "[INFO] $(date) - CHH regional-frac at MeCP2 peaks (240GB, shared)"

modality -v get regional-frac \
    --zarr-path /expanse/lustre/projects/csd940/zalibhai/biomodal/evoC-run/output/duet-1.5.0_evoC_Bap1_run_6bp/sample_outputs/zarr_store/CHH/evoC_Bap1_run.genome.GRCm38_primary_assembly.dedup.CHH.zarrz \
    --sample-sheet metadata.tsv \
    --bedfile mecp2_peaks.annotation.bed \
    --fields mc hmc \
    --min-coverage 10 \
    --order-by-group condition \
    --output-dir outputs_CHH_mecp2/Results/mecp2_peaks.annotation

echo "[INFO] $(date) - Done (exit code: $?)"
