#!/bin/bash
#SBATCH --job-name=modality_ctrl
#SBATCH --output=logs/modality_ctrl_%j.out
#SBATCH --partition=shared
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=128G
#SBATCH --time=06:00:00
#SBATCH --account=csd940

# Control-region non-CG methylation extraction
# Matched shuffled 400bp regions (8,886 total) as baseline for Section 53
#
# Usage: sbatch run_modality_control.sb CHG
#        sbatch run_modality_control.sb CHH

CONTEXT=$1

if [ -z "$CONTEXT" ]; then
    echo "Error: No context specified. Usage: sbatch run_modality_control.sb [CHG|CHH]"
    exit 1
fi

start_time=$(date +%s)

log_info()  { echo "[INFO] $(date '+%Y-%m-%d %H:%M:%S') - $1"; }
log_error() { echo "[ERROR] $(date '+%Y-%m-%d %H:%M:%S') - $1" >&2; }

echo "========================================="
echo "Modality Control Regions - ${CONTEXT} Context"
echo "========================================="
echo "Job ID:   $SLURM_JOB_ID"
echo "Node:     $HOSTNAME"
echo "CPUs:     $SLURM_CPUS_PER_TASK"
echo "Memory:   128GB"
echo "Start:    $(date)"
echo "========================================="
echo ""

source ~/.bashrc
conda activate modality

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
WORK_DIR="/expanse/lustre/projects/csd940/zalibhai/biomodal/modality"
REPO_DIR="/expanse/lustre/projects/csd940/zalibhai/mariner_hi-c/biomodal/downstream/modality"

ZARR="/expanse/lustre/projects/csd940/zalibhai/biomodal/evoC-run/output/duet-1.5.0_evoC_Bap1_run_6bp/sample_outputs/zarr_store/${CONTEXT}/evoC_Bap1_run.genome.GRCm38_primary_assembly.dedup.${CONTEXT}.zarrz"
METADATA="${WORK_DIR}/metadata.tsv"
GROUP_COLUMN="condition"
CONDITION_ORDER="control mutant"
MIN_COVERAGE=10

RAW_BED="${REPO_DIR}/mecp2/control_peaks.annotation.bed.gz"
PROCESSED_BED="${WORK_DIR}/control_peaks.annotation.bed"

OUTPUT_BASE="${WORK_DIR}/outputs_${CONTEXT}_control"
REGION_RESULTS_DIR="${OUTPUT_BASE}/Results/control_peaks.annotation"
REGION_REPORTS_DIR="${OUTPUT_BASE}/Reports/control_peaks.annotation"

cd "${WORK_DIR}"

# ---------------------------------------------------------------------------
# Input validation
# ---------------------------------------------------------------------------
log_info "Validating inputs..."

if [[ ! -f "${RAW_BED}" ]]; then
    log_error "Control regions BED not found: ${RAW_BED}"
    log_error "Run prepare_section53_control_bed.R locally and push to repo first."
    exit 1
fi
if [[ ! -f "${ZARR}" ]]; then
    log_error "Zarr store not found: ${ZARR}"
    exit 1
fi
if [[ ! -f "${METADATA}" ]]; then
    log_error "Metadata not found: ${METADATA}"
    exit 1
fi

log_info "All inputs validated."

# ---------------------------------------------------------------------------
# Output directories
# ---------------------------------------------------------------------------
mkdir -p "${REGION_RESULTS_DIR}" "${REGION_REPORTS_DIR}" logs

# ---------------------------------------------------------------------------
# STEP 0: Decompress BED if needed
# ---------------------------------------------------------------------------
echo ""
echo "====================================="
echo "STEP 0: PREPARING BED FILE"
echo "====================================="

if [[ -f "${PROCESSED_BED}" ]]; then
    log_info "Processed BED already exists, skipping: ${PROCESSED_BED}"
else
    log_info "Decompressing control regions BED..."
    gunzip -c "${RAW_BED}" > "${PROCESSED_BED}"
    NLINES=$(wc -l < "${PROCESSED_BED}")
    log_info "Processed BED written: ${PROCESSED_BED} (${NLINES} lines including header)"
fi

FIRST_CHROM=$(awk 'NR==2{print $1}' "${PROCESSED_BED}")
if [[ "${FIRST_CHROM}" == chr* ]]; then
    log_error "chr prefix still present in processed BED. Aborting."
    exit 1
fi
log_info "Chromosome format OK (first chrom: ${FIRST_CHROM})"

# ---------------------------------------------------------------------------
# STEP 1: Count (total_c)
# ---------------------------------------------------------------------------
echo ""
echo "====================================="
echo "STEP 1: FEATURE EXTRACTION - COUNT"
echo "====================================="
log_info "Running: modality get count (total_c)..."

modality -v get count \
    --zarr-path "${ZARR}" \
    --sample-sheet "${METADATA}" \
    --bedfile "${PROCESSED_BED}" \
    --fields total_c \
    --output-dir "${REGION_RESULTS_DIR}"

log_info "Count step complete."

# ---------------------------------------------------------------------------
# STEP 2: Mean (total_c)
# ---------------------------------------------------------------------------
echo ""
echo "====================================="
echo "STEP 2: FEATURE EXTRACTION - MEAN"
echo "====================================="
log_info "Running: modality get mean (total_c)..."

modality -v get mean \
    --zarr-path "${ZARR}" \
    --sample-sheet "${METADATA}" \
    --bedfile "${PROCESSED_BED}" \
    --fields total_c \
    --order-by-group "${GROUP_COLUMN}" \
    --output-dir "${REGION_RESULTS_DIR}"

find "${REGION_RESULTS_DIR}" -type f -name "*mean_extract_report*.html" \
    -exec cp {} "${REGION_REPORTS_DIR}/" \; 2>/dev/null || true
log_info "Mean step complete."

# ---------------------------------------------------------------------------
# STEP 3: Regional fraction (mc + hmc)
# ---------------------------------------------------------------------------
echo ""
echo "====================================="
echo "STEP 3: FEATURE EXTRACTION - REGIONAL-FRAC"
echo "====================================="
log_info "Running: modality get regional-frac (mc hmc, min-coverage ${MIN_COVERAGE})..."

modality -v get regional-frac \
    --zarr-path "${ZARR}" \
    --sample-sheet "${METADATA}" \
    --bedfile "${PROCESSED_BED}" \
    --fields mc hmc \
    --min-coverage "${MIN_COVERAGE}" \
    --order-by-group "${GROUP_COLUMN}" \
    --output-dir "${REGION_RESULTS_DIR}"

find "${REGION_RESULTS_DIR}" -type f -name "*regional-frac_extract_report*.html" \
    -exec cp {} "${REGION_REPORTS_DIR}/" \; 2>/dev/null || true
log_info "Regional-frac step complete."

# ---------------------------------------------------------------------------
# STEP 4: DMR calling
# ---------------------------------------------------------------------------
echo ""
echo "====================================="
echo "STEP 4: DMR CALLING"
echo "====================================="
log_info "Running: modality dmr call..."

modality dmr call \
    --zarr-path "${ZARR}" \
    --sample-sheet "${METADATA}" \
    --bedfile "${PROCESSED_BED}" \
    --condition-array-name "${GROUP_COLUMN}" \
    --condition-order ${CONDITION_ORDER} \
    --covariates sex \
    --methylation-contexts mc \
    --min-coverage "${MIN_COVERAGE}" \
    --output-dir "${REGION_RESULTS_DIR}"

log_info "DMR calling complete."

# ---------------------------------------------------------------------------
# Done
# ---------------------------------------------------------------------------
echo ""
echo "========================================="
end_time=$(date +%s)
duration=$((end_time - start_time))
log_info "All steps completed successfully."
log_info "Results: ${REGION_RESULTS_DIR}"
log_info "Reports: ${REGION_REPORTS_DIR}"
log_info "Total runtime: ${duration} seconds"
echo "End: $(date)"
echo "========================================="
