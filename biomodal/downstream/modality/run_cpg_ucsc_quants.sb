#!/bin/bash
#SBATCH --job-name=modality_cpg_ucsc
#SBATCH --output=logs/cpg_ucsc_%j.out
#SBATCH --partition=shared
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=2:00:00
#SBATCH --account=csd940

# Usage: sbatch run_cpg_ucsc_quants.sb
#
# Runs feature extraction (count, mean, regional-frac) for the full UCSC
# CpG island set (sorted_CpGmm10.bed, 16,009 regions) against the CG zarr
# store from run-5 (8 samples, deep-seq).

start_time=$(date +%s)

log_info()    { echo "[INFO] $(date '+%Y-%m-%d %H:%M:%S') - $1"; }
log_error()   { echo "[ERROR] $(date '+%Y-%m-%d %H:%M:%S') - $1" >&2; }

echo "========================================="
echo "Modality Quants - UCSC CpG Islands (CG)"
echo "========================================="
echo "Job ID:   $SLURM_JOB_ID"
echo "Node:     $HOSTNAME"
echo "CPUs:     $SLURM_CPUS_PER_TASK"
echo "Memory:   64GB"
echo "Start:    $(date)"
echo "========================================="
echo ""

source ~/.bashrc
conda activate modality

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
WORK_DIR="/expanse/lustre/projects/csd940/zalibhai/biomodal/modality"
REPO_DIR="/expanse/lustre/projects/csd940/zalibhai/mariner_hi-c/biomodal/downstream/modality"

ZARR="/expanse/lustre/projects/csd940/zalibhai/biomodal/evoC-run/output/duet-1.5.0_evoC_Bap1_run_6bp/sample_outputs/zarr_store/CG/evoC_Bap1_run.genome.GRCm38_primary_assembly.dedup.CG.zarrz"
METADATA="${WORK_DIR}/metadata.tsv"
GROUP_COLUMN="condition"
MIN_COVERAGE=10

RAW_BED="${REPO_DIR}/sorted_CpGmm10.bed"
PROCESSED_BED="${WORK_DIR}/sorted_CpGmm10.annotation.bed"

OUTPUT_BASE="${WORK_DIR}/outputs/cpg_ucsc_CG"
REGION_RESULTS_DIR="${OUTPUT_BASE}/Results/sorted_CpGmm10.annotation"
REGION_REPORTS_DIR="${OUTPUT_BASE}/Reports/sorted_CpGmm10.annotation"

cd "${WORK_DIR}"

# ---------------------------------------------------------------------------
# Input validation
# ---------------------------------------------------------------------------
log_info "Validating inputs..."

if [[ ! -f "${RAW_BED}" ]]; then
    log_error "Raw BED not found: ${RAW_BED}"
    exit 1
fi
if [[ ! -f "${ZARR}" ]]; then
    log_error "Zarr store not found: ${ZARR}"
    exit 1
fi
if [[ ! -f "${METADATA}" ]]; then
    log_error "Metadata not found: ${METADATA}"
    exit 1
fi

log_info "All inputs validated."

# ---------------------------------------------------------------------------
# Output directories
# ---------------------------------------------------------------------------
mkdir -p "${REGION_RESULTS_DIR}" "${REGION_REPORTS_DIR}" logs

# ---------------------------------------------------------------------------
# STEP 0: Preprocess BED file
# Strip chr prefix, add header, add Annotation column
# ---------------------------------------------------------------------------
echo ""
echo "====================================="
echo "STEP 0: PREPROCESSING BED FILE"
echo "====================================="

if [[ -f "${PROCESSED_BED}" ]]; then
    log_info "Preprocessed BED already exists, skipping: ${PROCESSED_BED}"
else
    log_info "Preprocessing: stripping chr prefix, adding header + Annotation column..."
    awk 'BEGIN { print "Chromosome\tStart\tEnd\tAnnotation" }
         {
           chrom = $1
           sub(/^chr/, "", chrom)
           print chrom "\t" $2 "\t" $3 "\tCpG_island"
         }' "${RAW_BED}" > "${PROCESSED_BED}"

    NLINES=$(wc -l < "${PROCESSED_BED}")
    if [[ "${NLINES}" -ne 16010 ]]; then
        log_error "Preprocessed BED has unexpected line count: ${NLINES} (expected 16010)"
        exit 1
    fi
    log_info "Preprocessed BED written: ${PROCESSED_BED} (${NLINES} lines including header)"
fi

FIRST_CHROM=$(awk 'NR==2{print $1}' "${PROCESSED_BED}")
if [[ "${FIRST_CHROM}" == chr* ]]; then
    log_error "chr prefix still present in processed BED. Aborting."
    exit 1
fi
log_info "Chromosome format OK (first chrom: ${FIRST_CHROM})"

# ---------------------------------------------------------------------------
# STEP 1: Count (total_c)
# ---------------------------------------------------------------------------
echo ""
echo "====================================="
echo "STEP 1: FEATURE EXTRACTION - COUNT"
echo "====================================="
log_info "Running: modality get count (total_c)..."

modality -v get count \
    --zarr-path "${ZARR}" \
    --sample-sheet "${METADATA}" \
    --bedfile "${PROCESSED_BED}" \
    --fields total_c \
    --output-dir "${REGION_RESULTS_DIR}"

log_info "Count step complete."

# ---------------------------------------------------------------------------
# STEP 2: Mean (total_c)
# ---------------------------------------------------------------------------
echo ""
echo "====================================="
echo "STEP 2: FEATURE EXTRACTION - MEAN"
echo "====================================="
log_info "Running: modality get mean (total_c)..."

modality -v get mean \
    --zarr-path "${ZARR}" \
    --sample-sheet "${METADATA}" \
    --bedfile "${PROCESSED_BED}" \
    --fields total_c \
    --order-by-group "${GROUP_COLUMN}" \
    --output-dir "${REGION_RESULTS_DIR}"

find "${REGION_RESULTS_DIR}" -type f -name "*mean_extract_report*.html" \
    -exec cp {} "${REGION_REPORTS_DIR}/" \; 2>/dev/null || true
log_info "Mean step complete."

# ---------------------------------------------------------------------------
# STEP 3: Regional fraction (mc + hmc)
# ---------------------------------------------------------------------------
echo ""
echo "====================================="
echo "STEP 3: FEATURE EXTRACTION - REGIONAL-FRAC"
echo "====================================="
log_info "Running: modality get regional-frac (mc hmc, min-coverage ${MIN_COVERAGE})..."

modality -v get regional-frac \
    --zarr-path "${ZARR}" \
    --sample-sheet "${METADATA}" \
    --bedfile "${PROCESSED_BED}" \
    --fields mc hmc \
    --min-coverage "${MIN_COVERAGE}" \
    --order-by-group "${GROUP_COLUMN}" \
    --output-dir "${REGION_RESULTS_DIR}"

find "${REGION_RESULTS_DIR}" -type f -name "*regional-frac_extract_report*.html" \
    -exec cp {} "${REGION_REPORTS_DIR}/" \; 2>/dev/null || true
log_info "Regional-frac step complete."

# ---------------------------------------------------------------------------
# Done
# ---------------------------------------------------------------------------
echo ""
echo "========================================="
end_time=$(date +%s)
duration=$((end_time - start_time))
log_info "All quant steps completed successfully."
log_info "Results: ${REGION_RESULTS_DIR}"
log_info "Reports: ${REGION_REPORTS_DIR}"
log_info "Total runtime: ${duration} seconds"
echo "End: $(date)"
echo "========================================="
