library(ggplot2)
library(clusterProfiler)
# Convert GSEA result to a data frame
gse_df <- as.data.frame(gse)
# Only proceed if there are enriched terms
if(nrow(gse_df) > 0){
# Add a .sign column
gse_df$.sign <- ifelse(gse_df$NES > 0, "activated", "suppressed")
# Create a dotplot manually using ggplot2
p <- ggplot(gse_df[1:10, ], aes(x = reorder(Description, NES), y = NES, size = Count, color = p.adjust)) +
geom_point() +
coord_flip() +
facet_grid(. ~ .sign) +
scale_color_gradient(low = "blue", high = "red") +
labs(x = "", y = "Normalized Enrichment Score (NES)", color = "Adjusted p-value", size = "Gene Count") +
theme_bw()
print(p)
ggsave("GSEA_dotplot.png", plot = p, width = 10, height = 6, dpi = 300)
} else {
message("Skipping dotplot: no enriched categories")
}
