# 1. Get pathways for human (replace "Homo sapiens" with your species if needed)
msigdbr_df <- msigdbr(species = "Mus musculus", category = "C2")  # C2 = curated pathways
# 2. Convert to named list for fgsea
pathways <- split(msigdbr_df$entrez_gene, msigdbr_df$gs_name)
# 3. Check your gene_list names
head(names(gene_list))  # should be Entrez IDs (as character)
gene_list <- sort(gene_list, decreasing = TRUE)  # fgsea expects decreasing order
# 4. Run fgsea
fgseaRes <- fgsea(pathways = pathways, stats = gene_list, nperm = 10000)
# 5. Inspect top results
fgseaRes[order(padj)][1:10, ]
```
names(gene_list) <- as.character(names(gene_list))
# ==============================================
# Libraries
# ==============================================
library(ggplot2)
library(clusterProfiler)
library(msigdbr)
library(fgsea)
library(org.Mm.eg.db)  # for gseGO
# ==============================================
# Prepare gene list
# ==============================================
gene_list <- sort(gene_list, decreasing = TRUE)
names(gene_list) <- as.character(names(gene_list))  # ensure names are character Entrez IDs
# ==============================================
# Obtain pathway collections (MsigDB)
# ==============================================
msigdbr_df <- msigdbr(species = "Mus musculus", category = "C2")  # C2 = curated pathways
pathways <- split(msigdbr_df$entrez_gene, msigdbr_df$gs_name)
# ==============================================
# Run fgsea
# ==============================================
fgseaRes <- fgsea(pathways = pathways, stats = gene_list, nperm = 10000)
# Inspect top 10 results
topPathways <- fgseaRes[order(fgseaRes$padj)][1:10, ]
topPathways
# ==============================================
# Prepare data for dotplot
# ==============================================
gsea_df <- as.data.frame(fgseaRes)
if(nrow(gsea_df) > 0){
# Add activation/suppression label
gsea_df$.sign <- ifelse(gsea_df$NES > 0, "activated", "suppressed")
# Take top 10 pathways for plotting
top_plot <- gsea_df[order(gsea_df$padj)[1:10], ]
# Dotplot
p <- ggplot(top_plot, aes(x = reorder(pathway, NES), y = NES, size = size, color = padj)) +
geom_point() +
coord_flip() +
facet_grid(. ~ .sign) +
scale_color_gradient(low = "blue", high = "red") +
labs(
x = "", y = "Normalized Enrichment Score (NES)",
color = "Adjusted p-value", size = "Gene Count"
) +
theme_bw()
print(p)
# Save figure
ggsave("GSEA_dotplot.png", plot = p, width = 10, height = 6, dpi = 300)
} else {
message("Skipping dotplot: no enriched categories")
}
# ==============================================
# Optional: Run gseGO with relaxed cutoffs
# ==============================================
gse_relaxed <- gseGO(
geneList = gene_list,
OrgDb = org.Mm.eg.db,
ont = "BP",
minGSSize = 5,
maxGSSize = 500,
pvalueCutoff = 0.1,
verbose = TRUE
)
# Summary of gseGO results
summary(gse_relaxed)
# Summary of gseGO results
as.data.frame(gse_relaxed)
# ==============================================
# Libraries
# ==============================================
library(ggplot2)
library(clusterProfiler)
library(msigdbr)
library(fgsea)
library(org.Mm.eg.db)  # for gseGO
# ==============================================
# Prepare gene list
# ==============================================
gene_list <- sort(gene_list, decreasing = TRUE)
names(gene_list) <- as.character(names(gene_list))  # ensure names are character Entrez IDs
# ==============================================
# Obtain pathway collections (MsigDB)
# ==============================================
msigdbr_df <- msigdbr(species = "Mus musculus", category = "C2")  # C2 = curated pathways
pathways <- split(msigdbr_df$entrez_gene, msigdbr_df$gs_name)
# ==============================================
# Run fgsea
# ==============================================
fgseaRes <- fgsea(pathways = pathways, stats = gene_list, nperm = 10000)
# Inspect top 10 results
topPathways <- fgseaRes[order(fgseaRes$padj)][1:10, ]
topPathways
# ==============================================
# Prepare data for dotplot
# ==============================================
gsea_df <- as.data.frame(fgseaRes)
if(nrow(gsea_df) > 0){
# Add activation/suppression label
gsea_df$.sign <- ifelse(gsea_df$NES > 0, "activated", "suppressed")
# Take top 10 pathways for plotting
top_plot <- gsea_df[order(gsea_df$padj)[1:10], ]
# Dotplot
p <- ggplot(top_plot, aes(x = reorder(pathway, NES), y = NES, size = size, color = padj)) +
geom_point() +
coord_flip() +
facet_grid(. ~ .sign) +
scale_color_gradient(low = "blue", high = "red") +
labs(
x = "", y = "Normalized Enrichment Score (NES)",
color = "Adjusted p-value", size = "Gene Count"
) +
theme_bw()
print(p)
# Save figure
ggsave("GSEA_dotplot.png", plot = p, width = 10, height = 6, dpi = 300)
} else {
message("Skipping dotplot: no enriched categories")
}
# ==============================================
# Optional: Run gseGO with relaxed cutoffs
# ==============================================
gse_relaxed <- gseGO(
geneList = gene_list,
OrgDb = org.Mm.eg.db,
ont = "BP",
minGSSize = 5,
maxGSSize = 500,
pvalueCutoff = 0.1,
verbose = TRUE
)
