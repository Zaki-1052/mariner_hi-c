#!/bin/bash
#SBATCH --job-name=export_noncg_bdg
#SBATCH --output=logs/export_bedgraph_noncg_%j.out
#SBATCH --partition=shared
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64G
#SBATCH --time=12:00:00
#SBATCH --account=csd940

# Export per-sample CHG and CHH mC bedGraphs from Zarr stores
# Only mC — evoC cannot distinguish mC/hmC at non-CG contexts
#
# Usage: sbatch export_bedgraph_noncg.sb
#
# Then convert with bedgraph_to_bigwig_noncg.sb

mkdir -p logs

echo "========================================="
echo "Zarr to bedGraph Export (CHG + CHH mC)"
echo "========================================="
echo "Job ID: $SLURM_JOB_ID"
echo "Node: $HOSTNAME"
echo "Start time: $(date)"
echo "========================================="
echo ""

source ~/.bashrc
conda activate modality

ZARR_BASE="/expanse/lustre/projects/csd940/zalibhai/biomodal/evoC-run/output/duet-1.5.0_evoC_Bap1_run_6bp/sample_outputs/zarr_store"
OUTDIR="/expanse/lustre/projects/csd940/zalibhai/biomodal/modality/exports/bedgraph"

for CONTEXT in CHG CHH; do
    echo ""
    echo "====================================="
    echo "Exporting ${CONTEXT} mC bedGraphs"
    echo "====================================="

    ZARR="${ZARR_BASE}/${CONTEXT}/evoC_Bap1_run.genome.GRCm38_primary_assembly.dedup.${CONTEXT}.zarrz"
    CONTEXT_OUTDIR="${OUTDIR}/${CONTEXT}_mc"

    mkdir -p "${CONTEXT_OUTDIR}"

    if [[ ! -f "${ZARR}" ]]; then
        echo "ERROR: Zarr not found: ${ZARR}"
        exit 1
    fi

    echo "Zarr: ${ZARR}"
    echo "Output: ${CONTEXT_OUTDIR}"
    echo ""

    modality export bedgraph \
      --zarr-path "${ZARR}" \
      --modification-count-column mc \
      --denominator-column total_c \
      --tag genome \
      --skip-rows-zero-counts \
      --tabix \
      --output-dir "${CONTEXT_OUTDIR}"

    echo ""
    echo "${CONTEXT} mC export complete: $(ls -1 ${CONTEXT_OUTDIR}/*.gz 2>/dev/null | wc -l) files"
done

echo ""
echo "========================================="
echo "Export complete"
echo "CHG mC bedGraphs: ${OUTDIR}/CHG_mc/"
echo "CHH mC bedGraphs: ${OUTDIR}/CHH_mc/"
echo "End time: $(date)"
echo "========================================="
