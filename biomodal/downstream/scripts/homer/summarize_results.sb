#!/bin/bash
# biomodal/downstream/scripts/homer/summarize_results.sb
#SBATCH --job-name=homer_summarize
#SBATCH --output=logs/homer_summarize_%j.out
#SBATCH --partition=shared
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=4G
#SBATCH --time=00:30:00
#SBATCH --account=csd940

echo "================================================================="
echo "HOMER Motif Enrichment — Results Summary"
echo "================================================================="
echo "Job ID: $SLURM_JOB_ID"
echo "Node: $HOSTNAME"
echo "Start time: $(date)"
echo "================================================================="
echo ""

# ─────────────────────────────────────────────────────────────────────
# Configuration
# ─────────────────────────────────────────────────────────────────────

BASE_DIR="/expanse/lustre/projects/csd940/zalibhai/mariner_hi-c"
OUTPUT_BASE="${BASE_DIR}/biomodal/downstream/results/homer_motif_enrichment"

ALL_COMPARISONS=(
    "A1_mc_hyper_vs_genome"
    "A2_mc_hypo_vs_genome"
    "A3_hmc_hyper_vs_genome"
    "A4_hmc_hypo_vs_genome"
    "A5_coordinated_vs_discordant"
    "B1_k119ub_gained_vs_lost"
    "B2_k119ub_lost_vs_gained"
    "B3_diffbind_gained_vs_lost"
    "B4_diffbind_lost_vs_gained"
    "C1_k27ac_gained_vs_lost"
    "C2_k27ac_lost_vs_gained"
    "C3_k27ac_gained_vs_genome"
    "C4_k27ac_lost_vs_genome"
)

MOTIFS_OF_INTEREST=(
    "REST" "NRSF" "YY1" "SUZ12" "EZH2"
    "NeuroD" "MEF2" "CREB" "Brn2" "POU3F2"
    "FOXK1" "FOXK2" "ASXL"
    "CXXC" "IDAX" "TET"
)

# ─────────────────────────────────────────────────────────────────────
# Per-comparison results
# ─────────────────────────────────────────────────────────────────────

COMPLETED=0
FAILED=0

for OUTDIR in "${ALL_COMPARISONS[@]}"; do
    OUTPATH="${OUTPUT_BASE}/${OUTDIR}"
    KNOWN="${OUTPATH}/knownResults.txt"

    echo "--- ${OUTDIR} ---"

    if [ ! -f "${KNOWN}" ]; then
        echo "  WARNING: knownResults.txt not found (job may have failed)"
        FAILED=$((FAILED + 1))
        echo ""
        continue
    fi

    COMPLETED=$((COMPLETED + 1))
    SIG_COUNT=$(awk -F'\t' 'NR>1 && $6+0 < 0.05' "${KNOWN}" | wc -l | tr -d ' ')
    echo "  Significant known motifs (q < 0.05): ${SIG_COUNT}"

    echo "  Top 5 known motifs:"
    awk -F'\t' 'NR>1 && NR<=6 {printf "    %s  p=%s  q=%s\n", $1, $3, $6}' "${KNOWN}"

    echo "  Motifs of interest:"
    for MOTIF in "${MOTIFS_OF_INTEREST[@]}"; do
        HIT=$(grep -i "${MOTIF}" "${KNOWN}" | head -1)
        if [ -n "${HIT}" ]; then
            MOT_NAME=$(echo "${HIT}" | cut -f1)
            MOT_P=$(echo "${HIT}" | cut -f3)
            MOT_Q=$(echo "${HIT}" | cut -f6)
            echo "    ${MOTIF}: ${MOT_NAME}  p=${MOT_P}  q=${MOT_Q}"
        fi
    done

    DENOVO_COUNT=$(ls "${OUTPATH}"/homerResults/motif*.motif 2>/dev/null | wc -l | tr -d ' ')
    echo "  De novo motifs found: ${DENOVO_COUNT}"
    echo ""
done

# ─────────────────────────────────────────────────────────────────────
# Final status
# ─────────────────────────────────────────────────────────────────────

TOTAL=${#ALL_COMPARISONS[@]}
echo "================================================================="
echo "Summary: ${COMPLETED}/${TOTAL} completed, ${FAILED}/${TOTAL} missing/failed"
echo ""
echo "Output directory: ${OUTPUT_BASE}"
echo ""
echo "Next steps:"
echo "  1. Review HTML reports: \${OUTPUT_BASE}/*/knownResults.html"
echo "  2. Transfer results to local:"
echo "     scp -r expanse:${OUTPUT_BASE} biomodal/downstream/results/"
echo "  3. Check B1/B3/C1 (K119ub/K27ac gained) for Polycomb-related motifs (REST, YY1, SUZ12)"
echo "  4. Check A1/A5 (mC hyper/coordinated) for neuron-specific TFs (NeuroD, MEF2, CREB)"
echo "  5. Compare A1 vs A2 for direction-specific motif enrichment"
echo "  6. Compare C1 vs C2 for K27ac direction-specific TFs"
echo ""
echo "End time: $(date)"
echo "================================================================="

exit ${FAILED}
