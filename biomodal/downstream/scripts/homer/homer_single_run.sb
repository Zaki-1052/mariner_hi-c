#!/bin/bash
# biomodal/downstream/scripts/homer/homer_single_run.sb
#SBATCH --job-name=homer_run
#SBATCH --output=logs/homer_%j.out
#SBATCH --partition=shared
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=48:00:00
#SBATCH --account=csd940

FG_FILE="${1:?Error: foreground BED filename required (arg 1)}"
BG_SPEC="${2:?Error: background BED filename or GENOME required (arg 2)}"
OUTDIR_NAME="${3:?Error: output directory name required (arg 3)}"

echo "================================================================="
echo "HOMER findMotifsGenome.pl — Single Comparison"
echo "================================================================="
echo "Job ID: $SLURM_JOB_ID"
echo "Node: $HOSTNAME"
echo "Start time: $(date)"
echo ""
echo "Arguments:"
echo "  Foreground: ${FG_FILE}"
echo "  Background: ${BG_SPEC}"
echo "  Output dir: ${OUTDIR_NAME}"
echo "================================================================="
echo ""

source ~/.bashrc
source activate homer1

# ─────────────────────────────────────────────────────────────────────
# Configuration
# ─────────────────────────────────────────────────────────────────────

BASE_DIR="/expanse/lustre/projects/csd940/zalibhai/mariner_hi-c"
OUTPUT_BASE="${BASE_DIR}/biomodal/downstream/results/homer_motif_enrichment"
BED_DIR="${OUTPUT_BASE}/beds"
GENOME="mm10"
CPUS=${SLURM_CPUS_PER_TASK:-8}
OUTPATH="${OUTPUT_BASE}/${OUTDIR_NAME}"

# ─────────────────────────────────────────────────────────────────────
# Validation
# ─────────────────────────────────────────────────────────────────────

FG_PATH="${BED_DIR}/${FG_FILE}"
if [ ! -s "${FG_PATH}" ]; then
    echo "ERROR: Foreground BED missing or empty: ${FG_PATH}"
    exit 1
fi
echo "Foreground: ${FG_PATH} ($(wc -l < "${FG_PATH}") regions)"

if [ "${BG_SPEC}" = "GENOME" ]; then
    echo "Background: genome (auto-sampled)"
else
    BG_PATH="${BED_DIR}/${BG_SPEC}"
    if [ ! -s "${BG_PATH}" ]; then
        echo "ERROR: Background BED missing or empty: ${BG_PATH}"
        exit 1
    fi
    echo "Background: ${BG_PATH} ($(wc -l < "${BG_PATH}") regions)"
fi
echo ""

# ─────────────────────────────────────────────────────────────────────
# Run HOMER
# ─────────────────────────────────────────────────────────────────────

rm -rf "${OUTPATH}"
mkdir -p "${OUTPATH}"

echo "Running findMotifsGenome.pl..."
echo "  Genome: ${GENOME}"
echo "  CPUs:   ${CPUS}"
echo "  Flags:  -size given -mask"
echo "  Start:  $(date)"
echo ""

if [ "${BG_SPEC}" = "GENOME" ]; then
    findMotifsGenome.pl \
        "${FG_PATH}" \
        "${GENOME}" \
        "${OUTPATH}" \
        -size given \
        -mask \
        -p ${CPUS}
else
    findMotifsGenome.pl \
        "${FG_PATH}" \
        "${GENOME}" \
        "${OUTPATH}" \
        -bg "${BG_PATH}" \
        -size given \
        -mask \
        -p ${CPUS}
fi

EXIT_CODE=$?

echo ""
if [ ${EXIT_CODE} -ne 0 ]; then
    echo "HOMER FAILED (exit code ${EXIT_CODE})"
else
    echo "HOMER completed successfully."
    if [ -f "${OUTPATH}/knownResults.txt" ]; then
        SIG=$(awk -F'\t' 'NR>1 && $6+0 < 0.05' "${OUTPATH}/knownResults.txt" | wc -l | tr -d ' ')
        echo "  Significant known motifs (q < 0.05): ${SIG}"
    fi
fi
echo ""
echo "End time: $(date)"
echo "================================================================="

exit ${EXIT_CODE}
