#!/bin/bash
#SBATCH --job-name=modality_%x
#SBATCH --output=logs/modality_%j.out
#SBATCH --partition=shared
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=200G
#SBATCH --time=12:00:00
#SBATCH --account=csd940

# Usage: sbatch run_modality.sb CG
#        sbatch run_modality.sb CHG
#        sbatch run_modality.sb CHH

CONTEXT=$1

if [ -z "$CONTEXT" ]; then
    echo "Error: No context specified. Usage: sbatch run_modality.sb [CG|CHG|CHH]"
    exit 1
fi

# Create logs directory
mkdir -p logs

echo "========================================="
echo "Modality Run - ${CONTEXT} Context"
echo "========================================="
echo "Job ID: $SLURM_JOB_ID"
echo "Node: $HOSTNAME"
echo "CPUs: $SLURM_CPUS_PER_TASK"
echo "Memory: 128GB"
echo "Start time: $(date)"
echo "========================================="
echo ""

# Activate conda environment
source ~/.bashrc
conda activate modality

# Change to working directory
cd /expanse/lustre/projects/csd940/zalibhai/biomodal/modality

# Copy the appropriate config file
cp config_${CONTEXT}.txt config.txt

echo "Using config_${CONTEXT}.txt"
echo ""
cat config.txt
echo ""
echo "========================================="
echo ""

# Run the workflow
./core-workflow-v1.3.sh

echo ""
echo "========================================="
echo "End time: $(date)"
echo "========================================="