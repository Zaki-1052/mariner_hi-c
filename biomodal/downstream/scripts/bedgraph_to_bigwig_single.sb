#!/bin/bash
#SBATCH --partition=shared
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=12:00:00
#SBATCH --account=csd940
#SBATCH --output=logs/noncg/%x_%j.out

# Convert a single bedGraph to BigWig
# Usage: sbatch --job-name=<name> bedgraph_to_bigwig_single.sb <bedgraph.bdg.gz>

BDG="$1"

if [[ -z "$BDG" || ! -f "$BDG" ]]; then
    echo "ERROR: bedGraph file not found: $BDG"
    exit 1
fi

source ~/.bashrc
conda activate mariner_env

BASEDIR="/expanse/lustre/projects/csd940/zalibhai/biomodal/modality/exports"
OUTDIR="${BASEDIR}/bigwig"
CHROM_SIZES="${BASEDIR}/mm10.chrom.sizes"

if [[ ! -f "$CHROM_SIZES" ]]; then
    wget -q -O "$CHROM_SIZES" \
      "https://hgdownload.soe.ucsc.edu/goldenPath/mm10/bigZips/mm10.chrom.sizes"
fi

CONTEXT_DIR=$(basename "$(dirname "$BDG")")
SAMPLE=$(basename "$BDG" .bdg.gz)

mkdir -p "${OUTDIR}/${CONTEXT_DIR}"

BW="${OUTDIR}/${CONTEXT_DIR}/${SAMPLE}.bw"
TMP_BDG="${OUTDIR}/${CONTEXT_DIR}/tmp_${SAMPLE}_${SLURM_JOB_ID}.bdg"

echo "========================================="
echo "bedGraph -> BigWig"
echo "========================================="
echo "Job ID: $SLURM_JOB_ID"
echo "Node: $HOSTNAME"
echo "Start: $(date)"
echo "Input: $BDG"
echo "Output: $BW"
echo "========================================="

zcat "$BDG" \
  | awk -F'\t' 'BEGIN{OFS="\t"} {if($1!~/^chr/) $1="chr"$1; if($1~/^chr[0-9XYM]+$/) print}' \
  | sort -k1,1 -k2,2n --parallel=4 -S 24G > "$TMP_BDG"

if [[ ! -s "$TMP_BDG" ]]; then
    echo "ERROR: empty after decompression"
    rm -f "$TMP_BDG"
    exit 1
fi

bedGraphToBigWig "$TMP_BDG" "$CHROM_SIZES" "$BW" 2>&1

if [[ -f "$BW" ]]; then
    echo "Done: $(du -h "$BW" | cut -f1)"
else
    echo "ERROR: conversion failed"
    rm -f "$TMP_BDG"
    exit 1
fi

rm -f "$TMP_BDG"

echo "End: $(date)"
echo "========================================="
