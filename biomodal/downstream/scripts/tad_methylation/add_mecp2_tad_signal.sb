#!/bin/bash
#SBATCH --job-name=mecp2_tad
#SBATCH --output=logs/add_mecp2_tad_signal_%j.out
#SBATCH --partition=shared
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=128G
#SBATCH --time=12:00:00
#SBATCH --account=csd940

# Add MeCP2 ChIP-seq signal to TAD methylation TSV and compute
# bin-level residual variances for the CG-corrected proxy analysis.
#
# Usage:
#   cd /expanse/lustre/projects/csd940/zalibhai/mariner_hi-c/biomodal/downstream
#   sbatch scripts/tad_methylation/add_mecp2_tad_signal.sb

mkdir -p logs data

BW_DIR="/expanse/lustre/projects/csd940/zalibhai/bigwigs"
METH_DIR="/expanse/lustre/projects/csd940/zalibhai/biomodal/modality/exports/bigwig/merged"
INPUT="data/tad_methylation_signal_late.tsv"
OUTPUT="data/tad_methylation_signal_late.tsv"
BINVAR="data/tad_mecp2_binlevel_variance.tsv"

echo "========================================="
echo "MeCP2 TAD Signal Augmentation"
echo "========================================="
echo "Job ID: $SLURM_JOB_ID"
echo "Node: $HOSTNAME"
echo "Input: ${INPUT}"
echo "Output: ${OUTPUT}"
echo "BinVar: ${BINVAR}"
echo "Start time: $(date)"
echo "========================================="
echo ""

if [[ ! -f "$INPUT" ]]; then
    echo "ERROR: Input TSV not found: ${INPUT}"
    exit 1
fi

source ~/.bashrc
conda activate mariner_env

Rscript scripts/tad_methylation/add_mecp2_tad_signal.R \
    --input "${INPUT}" \
    --output "${OUTPUT}" \
    --ctrl-bw "${BW_DIR}/MeCP2Ctrl.bw" \
    --mut-bw "${BW_DIR}/MeCP2Mut.bw" \
    --peaks-up "../../peaks/mecp2/MeCP2_up.bed" \
    --peaks-down "../../peaks/mecp2/MeCP2_down.bed" \
    --cg-mc-ctrl "${METH_DIR}/CG_mc_ctrl.bw" \
    --cg-mc-mut "${METH_DIR}/CG_mc_mut.bw" \
    --cg-hmc-ctrl "${METH_DIR}/CG_hmc_ctrl.bw" \
    --cg-hmc-mut "${METH_DIR}/CG_hmc_mut.bw" \
    --binvar-output "${BINVAR}"

EXIT_CODE=$?

echo ""
echo "========================================="
echo "Exit code: ${EXIT_CODE}"
if [[ -f "$OUTPUT" ]]; then
    echo "Main TSV: $(wc -l < "$OUTPUT") lines, $(du -h "$OUTPUT" | cut -f1)"
fi
if [[ -f "$BINVAR" ]]; then
    echo "BinVar TSV: $(wc -l < "$BINVAR") lines, $(du -h "$BINVAR" | cut -f1)"
fi
echo "End time: $(date)"
echo "========================================="
