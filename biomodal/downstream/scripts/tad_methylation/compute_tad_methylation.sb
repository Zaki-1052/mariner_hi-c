#!/bin/bash
#SBATCH --job-name=tad_meth
#SBATCH --output=logs/compute_tad_methylation_%j.out
#SBATCH --partition=shared
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=12:00:00
#SBATCH --account=csd940

# Extract per-sample methylation signal over reconstructed TAD domains
# for CG mC, CG hmC, CHG mC, CHH mC contexts.
#
# Usage:
#   cd /expanse/lustre/projects/csd940/zalibhai/mariner_hi-c/biomodal/downstream
#   sbatch scripts/tad_methylation/compute_tad_methylation.sb [late|early]
#
# Default timepoint: late (adult, 250402)

mkdir -p logs data

TIMEPOINT="${1:-late}"
TAD_FILE="../../tads/results/${TIMEPOINT}/final/tadcompare_final_filtered.tsv"
BW_DIR="/expanse/lustre/projects/csd940/zalibhai/biomodal/modality/exports/bigwig"
OUTPUT="data/tad_methylation_signal_${TIMEPOINT}.tsv"

echo "========================================="
echo "TAD Methylation Signal Extraction"
echo "========================================="
echo "Job ID: $SLURM_JOB_ID"
echo "Node: $HOSTNAME"
echo "Timepoint: ${TIMEPOINT}"
echo "TAD file: ${TAD_FILE}"
echo "BigWig dir: ${BW_DIR}"
echo "Output: ${OUTPUT}"
echo "Start time: $(date)"
echo "========================================="
echo ""

if [[ ! -f "$TAD_FILE" ]]; then
    echo "ERROR: TAD file not found: ${TAD_FILE}"
    exit 1
fi

source ~/.bashrc
conda activate mariner_env

Rscript scripts/tad_methylation/compute_tad_methylation.R \
    --tad-file "${TAD_FILE}" \
    --timepoint "${TIMEPOINT}" \
    --bw-dir "${BW_DIR}" \
    --output "${OUTPUT}" \
    --min-domain-kb 100

EXIT_CODE=$?

echo ""
echo "========================================="
echo "Exit code: ${EXIT_CODE}"
if [[ -f "$OUTPUT" ]]; then
    echo "Output: $(wc -l < "$OUTPUT") lines, $(du -h "$OUTPUT" | cut -f1)"
fi
echo "End time: $(date)"
echo "========================================="
