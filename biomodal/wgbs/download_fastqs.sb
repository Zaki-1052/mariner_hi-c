#!/bin/bash
# biomodal/wgbs/download_fastqs.sb
# Download WGBS FASTQs from sequencing facility FTP to Expanse
#
# Usage: sbatch download_fastqs.sb

#SBATCH --job-name="dl_wgbs"
#SBATCH --output="logs/download_fastqs_%j.out"
#SBATCH --partition=shared
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=128G
#SBATCH --time=24:00:00
#SBATCH --account=csd940

FTP_BASE="ftp://igm-storage.ucsd.edu/260522_LH00444_0523_B23F7LGLT3/"
TARGET_DIR="/expanse/lustre/projects/csd940/zalibhai/methylseq/fastqs"
echo "Started: $(date)"
mkdir -p "$TARGET_DIR"
mkdir -p logs

echo "Downloading all fastq.gz from $FTP_BASE to $TARGET_DIR"

wget -r -np -nd -A "*.fastq.gz" -P "$TARGET_DIR" "$FTP_BASE"

echo "Done. Contents:"
ls -lhS "$TARGET_DIR"/*.fastq.gz 2>/dev/null
du -sh "$TARGET_DIR"
echo "Finished: $(date)"